<view class="page shared-menu-page">
  <view wx:if="{{state === 'loading'}}" class="shared-state"><view class="shared-spinner"></view><text>正在读取好友酒单…</text></view>
  <view wx:elif="{{state === 'error'}}" class="shared-state">
    <text class="shared-state-title">暂时无法读取酒单</text><text class="shared-state-copy">{{errorMessage}}</text>
    <button class="shared-state-button" bindtap="onRetry">重新加载</button>
  </view>
  <view wx:elif="{{state === 'missing'}}" class="shared-state">
    <text class="shared-state-title">这份好友酒单暂时无法打开</text><text class="shared-state-copy">分享可能已经失效，或者作者停止了分享。</text>
    <button class="shared-state-button" bindtap="onBackToFriends">返回好友分享</button>
  </view>
  <block wx:else>
    <view class="shared-menu-heading">
      <view class="shared-menu-title-row"><text class="shared-menu-name">{{menu.name}}</text><text class="shared-name-edit" bindtap="onEditMenuName" aria-role="button">编辑名称</text><text class="shared-readonly-badge">只读</text></view>
      <view class="shared-menu-meta"><text>{{recipes.length}}款酒</text><view class="shared-sync-row"><view class="shared-sync-dot"></view><text>实时同步</text></view><text class="shared-updated">更新于{{menu.updatedLabel}}</text></view>
    </view>
    <view wx:if="{{state === 'empty'}}" class="shared-state compact">
      <text class="shared-state-title">这份酒单暂时没有酒款</text>
      <button class="shared-state-button" bindtap="onBackToFriends">返回好友分享</button>
    </view>
    <view wx:else class="shared-recipe-list">
      <recipe-card wx:for="{{recipes}}" wx:key="id" recipe="{{item}}" bind:select="onSelectRecipe" />
    </view>
  </block>
</view>
