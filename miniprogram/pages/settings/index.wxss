.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 96rpx 40rpx 160rpx;
  background: #f8f5ee;
}

.identity {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.avatar-shell {
  position: relative;
  display: flex;
  width: 144rpx;
  height: 144rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #ffffff;
  background: #242321;
  border-radius: 50%;
}

.avatar-picker {
  position: absolute;
  z-index: 1;
  inset: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  margin: 0;
  padding: 0;
  opacity: 0;
}

.avatar-picker::after {
  border: 0;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.nickname-input {
  width: 420rpx;
  height: 72rpx;
  margin-top: 24rpx;
  color: #242321;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 72rpx;
  text-align: center;
}

.data-panel {
  max-width: 560rpx;
  margin: 72rpx auto 0;
  overflow: hidden;
  background: transparent;
  border: 1rpx solid #e7e4dd;
  border-radius: 22rpx;
}

.sync-row,
.data-action {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 92rpx;
  margin: 0;
  padding: 0 28rpx;
  align-items: center;
  justify-content: space-between;
  background: transparent;
}

.data-action {
  border-top: 1rpx solid #ece9e2;
  font-weight: 400;
  line-height: 1.4;
  text-align: left;
}

.data-action-active { background: #f3f0e9; }

.sync-label,
.data-action-title {
  width: 180rpx;
  flex-shrink: 0;
  color: #242321;
  font-size: 27rpx;
  font-weight: 400;
  text-align: left;
  white-space: nowrap;
}

.sync-value,
.action-note {
  min-width: 0;
  margin-left: 24rpx;
  flex: 1;
  color: #77736d;
  font-size: 23rpx;
  font-weight: 400;
  text-align: right;
  white-space: nowrap;
}

.edit-hint {
  display: block;
  margin-top: 2rpx;
  color: #6f6c66;
  font-size: 22rpx;
  text-align: center;
}
