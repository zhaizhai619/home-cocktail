.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 28rpx 160rpx;
  background: #f7f1e8;
}

.profile-heading {
  padding: 0 6rpx 28rpx;
}

.profile-title,
.profile-subtitle,
.profile-card-title,
.profile-card-note {
  display: block;
}

.profile-title {
  color: #342f2b;
  font-size: 46rpx;
  font-weight: 700;
}

.profile-subtitle {
  margin-top: 8rpx;
  color: #847a70;
  font-size: 24rpx;
}

.profile-card {
  padding: 28rpx;
  background: #fffdf8;
  border: 1rpx solid #e8ddcf;
  border-radius: 24rpx;
}

.profile-card-title {
  color: #493d32;
  font-size: 29rpx;
  font-weight: 650;
}

.profile-card-note {
  margin-top: 10rpx;
  color: #8b8178;
  font-size: 23rpx;
  line-height: 1.6;
}
