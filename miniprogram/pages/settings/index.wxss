.settings-page { min-height:100vh; box-sizing:border-box; padding:32rpx 24rpx; background:#f7f1e8; }.heading { padding:16rpx 8rpx 24rpx; }.page-title,.page-subtitle,.section-title,.section-hint,.item-notes,.usage,.empty-copy { display:block; }.page-title { color:#342f2b; font-size:40rpx; font-weight:700; }.page-subtitle { margin-top:10rpx; color:#81766c; font-size:25rpx; }.section { margin-bottom:20rpx; padding:26rpx; background:#fffdf8; border-radius:22rpx; box-shadow:0 6rpx 24rpx rgba(74,55,38,.05); }.section-heading,.name-line,.tool-row,.sheet-heading,.image-actions { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }.section-title { color:#493d32; font-size:31rpx; font-weight:650; }.section-hint { margin-top:6rpx; color:#887e74; font-size:22rpx; }.add-button,.card-actions button,.row-actions button,.image-actions button,.close-button { min-height:88rpx; margin:0; padding:0 20rpx; border-radius:14rpx; font-size:24rpx; }.add-button { color:#8a5726; background:#f2e4d2; }.item-list { display:grid; gap:16rpx; margin-top:20rpx; }.equipment-card { display:grid; grid-template-columns:auto 1fr; gap:18rpx; padding:18rpx; background:#f7f0e7; border-radius:18rpx; }.equipment-image { width:104rpx; height:104rpx; border-radius:14rpx; }.equipment-content { min-width:0; }.item-name { color:#4d433a; font-size:27rpx; font-weight:600; }.capacity { color:#9a581f; font-size:25rpx; }.item-notes { margin-top:8rpx; color:#665d55; font-size:24rpx; line-height:1.5; }.usage { margin-top:8rpx; color:#8c8177; font-size:22rpx; }.card-actions { grid-column:1 / -1; display:grid; grid-template-columns:1fr 1fr; gap:12rpx; }.card-actions button,.row-actions button { color:#5c5148; background:#eee5da; }.danger { color:#a54d36 !important; background:#f5e5e0 !important; }.chip-list { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:20rpx; }.tool-chip { display:inline-flex; min-height:64rpx; align-items:center; gap:10rpx; padding:0 18rpx; color:#5d534a; background:#f0e9df; border-radius:999rpx; font-size:24rpx; }.built-in-mark { padding:3rpx 8rpx; color:#7a6c5f; background:#fffaf3; border-radius:999rpx; font-size:18rpx; }.tool-row { min-height:96rpx; padding:8rpx 0; border-bottom:1rpx solid #eee6dc; }.row-actions { display:flex; gap:10rpx; }.row-actions button { min-width:100rpx; }.empty-copy { margin-top:20rpx; color:#887e74; font-size:24rpx; line-height:1.6; }.bottom-space { height:80rpx; }.mask { position:fixed; z-index:20; inset:0; display:flex; align-items:flex-end; background:rgba(48,39,32,.4); }.sheet { width:100%; padding:28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:#fffdf8; border-radius:28rpx 28rpx 0 0; }.close-button { min-width:88rpx; padding:0; color:#665d55; background:#eee7de; font-size:36rpx; }.sheet input,.sheet textarea { box-sizing:border-box; width:100%; min-height:88rpx; margin-top:16rpx; padding:18rpx; color:#4e453d; background:#fff; border:1rpx solid #ded2c3; border-radius:14rpx; font-size:26rpx; }.sheet textarea { height:150rpx; }.editor-image-preview { display:block; width:160rpx; height:160rpx; margin-top:16rpx; border-radius:16rpx; }.image-actions { justify-content:flex-start; margin-top:14rpx; }.save-button { min-height:88rpx; margin-top:22rpx; color:#fffaf3; background:#a96826; border-radius:16rpx; font-size:27rpx; }
