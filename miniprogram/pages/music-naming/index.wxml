<view class="music-page">
  <view class="hero">
    <text class="beta">体验版</text>
    <text class="hero-title">让喜欢的歌先认识你的酒</text>
    <text class="hero-copy">歌曲只需解析一次，结果会保存在腾讯云；之后起名只做轻量匹配。</text>
  </view>

  <view class="panel">
    <text class="panel-title">大模型设置</text>
    <text class="field-label">DeepSeek API Key</text>
    <input class="field" password="true" value="{{apiKey}}" data-field="apiKey" bindinput="onFieldInput" placeholder="仅保存在当前设备" />
    <text class="field-help">明文仅保存在当前设备；解析期间云端只临时保存加密密文，任务结束后自动删除。</text>
    <text class="field-label">模型名称</text>
    <input class="field" value="{{model}}" data-field="model" bindinput="onFieldInput" placeholder="例如 deepseek-v4-flash" />
    <text class="field-label">导入歌曲数量</text>
    <input class="field" type="number" value="{{importCount}}" data-field="importCount" bindinput="onFieldInput" placeholder="1—300" />
  </view>

  <view class="panel">
    <view class="panel-heading"><text class="panel-title">网易云音乐</text><text class="connection {{ncmLoggedIn ? 'online' : ''}}">{{ncmLoggedIn ? '已连接' : '未连接'}}</text></view>
    <text wx:if="{{ncmNickname}}" class="connected-user">当前账号：{{ncmNickname}}</text>
    <image wx:if="{{ncmQrUrl && !ncmLoggedIn}}" class="login-qr" src="{{ncmQrUrl}}" mode="aspectFit" />
    <view class="row-actions">
      <button class="secondary" loading="{{loadingLogin}}" bindtap="onConnectNcm">连接网易云</button>
      <button class="secondary" loading="{{checkingLogin}}" disabled="{{checkingLogin || loadingLogin}}" bindtap="onCheckNcmLogin">{{checkingLogin ? '检查中…' : '检查登录'}}</button>
    </view>
  </view>

  <view class="panel progress-panel">
    <view class="panel-heading"><text class="panel-title">解析进度</text><text class="percent">{{percent}}%</text></view>
    <view class="progress-track"><view class="progress-value" style="width: {{percent}}%"></view></view>
    <view class="stats">
      <view><text class="stat-value">{{total}}</text><text class="stat-label">导入歌曲</text></view>
      <view><text class="stat-value">{{processed}}</text><text class="stat-label">已完成</text></view>
      <view><text class="stat-value">{{job ? job.progress.failed : 0}}</text><text class="stat-label">解析失败</text></view>
      <view><text class="stat-value">{{analyzedCount}}</text><text class="stat-label">云端画像</text></view>
    </view>
    <text wx:if="{{statusText}}" class="status">{{statusText}}</text>
    <text wx:if="{{job && job.status !== 'completed'}}" class="status">退出此页面后，云端仍会继续解析。</text>
    <text wx:if="{{error}}" class="error">{{error}}</text>
  </view>

  <button class="primary" loading="{{analyzing}}" disabled="{{analyzing}}" bindtap="onStartAnalysis">{{analyzing ? '解析中…' : '导入并开始解析'}}</button>
  <button wx:if="{{job && job.status === 'paused' && !analyzing}}" class="resume" bindtap="onResumeAnalysis">继续上次进度</button>
</view>
