.page { min-height:100vh; padding:20rpx 24rpx; box-sizing:border-box; background:#f7f1e8; }.section { margin-bottom:18rpx; padding:22rpx; background:#fffdf8; border-radius:18rpx; }.title { display:block; margin-bottom:16rpx; color:#493d32; font-size:30rpx; font-weight:600; }.section input,.section textarea,.select { box-sizing:border-box; width:100%; min-height:66rpx; margin:8rpx 0; padding:14rpx; background:#fff; border:1rpx solid #ded2c3; border-radius:10rpx; font-size:26rpx; }.section textarea { min-height:132rpx; }.quick-bases,.ratings { display:flex; flex-wrap:wrap; gap:10rpx; }.quick-bases button,.ratings button { margin:0; padding:7rpx 14rpx; color:#644f3f; background:#f4e8d9; border-radius:999rpx; font-size:23rpx; }.abv { display:block; margin-top:16rpx; color:#9a581f; font-size:30rpx; }.warning,.error { display:block; margin-top:10rpx; color:#a54d36; font-size:24rpx; }.recipe-image-preview{display:block;width:100%;height:260rpx;margin:12rpx 0;border-radius:14rpx}.bottom-space { height:120rpx; }.save-bar { position:fixed; z-index:5; right:0; bottom:0; left:0; padding:16rpx 24rpx; background:#fffdf8; box-shadow:0 -4rpx 20rpx rgba(0,0,0,.08); }.save-bar button { color:#fff; background:#a96826; }.mask { position:fixed; z-index:10; inset:0; display:flex; align-items:flex-end; background:rgba(0,0,0,.35); }.sheet { width:100%; max-height:70vh; padding:24rpx; overflow:auto; background:#fffdf8; border-radius:28rpx 28rpx 0 0; }.sheet button { display:block; width:100%; text-align:left; background:transparent; }.tool-option { display:flex; align-items:center; min-height:88rpx; gap:8rpx; border-bottom:1rpx solid #eee5da; font-size:26rpx; }.tool-option.orphaned { margin-top:8rpx; padding:0 12rpx; background:#f4eeea; border-radius:12rpx; }.missing-label { margin-left:auto; color:#a54d36; font-size:22rpx; }.capacity-line { display:block; margin-top:12rpx; color:#5d534a; font-size:25rpx; line-height:1.55; }.capacity-line.over,.capacity-line.incomplete { color:#8e4e31; font-weight:600; }
