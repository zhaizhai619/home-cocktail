.edit-page { box-sizing: border-box; min-height: 100vh; padding: 12rpx 16rpx 0; background: #f8f5ee; }
.section { margin-bottom: 10rpx; padding: 14rpx 12rpx; background: rgba(255, 255, 255, .92); border: 1rpx solid rgba(255, 255, 255, .72); border-radius: 18rpx; box-shadow: 0 5rpx 16rpx rgba(0, 0, 0, .035); }
.section-heading { display: flex; align-items: center; box-sizing: border-box; width: 100%; gap: 8rpx; }
.title { display: block; flex: 1; min-width: 0; color: #242321; font-size: 30rpx; font-weight: 720; white-space: nowrap; }
.tried-toggle { display: flex; flex: none; margin-left: auto; padding: 3rpx; background: #f1f0ec; border-radius: 999rpx; }
.edit-page .tried-option { width: 92rpx; min-height: 48rpx; margin: 0; padding: 0 8rpx; color: #6f6c66; background: transparent; border-radius: 999rpx; font-size: 21rpx; line-height: 48rpx; }
.tried-option.selected { color: #ffffff; background: #242321; }
.tried-option::after, .rating-chip::after, .shortcut::after, .sheet-option::after, .save-button::after { border: 0; }
.basic-status-row, .basic-rating-row { display: flex; align-items: center; box-sizing: border-box; width: 100%; min-width: 0; margin-top: 10rpx; gap: 10rpx; }
.basic-status-row { margin-top: 18rpx; }
.basic-status-row .tried-toggle { margin-left: 0; }
.basic-row-label { flex: none; width: 58rpx; color: #7f7b74; font-size: 21rpx; }
.rating-track { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); flex: 1; min-width: 0; gap: 6rpx; }
.edit-page .rating-chip, .edit-page .shortcut { flex: none; min-height: 54rpx; margin: 0; padding: 0 8rpx; color: #6f6c66; background: #f1f0ec; border: 1rpx solid transparent; border-radius: 999rpx; font-size: 21rpx; line-height: 54rpx; }
.edit-page .rating-chip { width: 100%; min-width: 0; padding: 0 3rpx; }
.rating-chip.selected, .shortcut.primary { color: #ffffff; background: #242321; }
.basic-grid { margin-top: 10rpx; }
.basic-fields { display: flex; width: 100%; min-width: 0; flex-direction: column; gap: 8rpx; }
.name-row { display: flex; align-items: stretch; width: 100%; gap: 8rpx; }
.name-input { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 650; }
.edit-page .ai-name-button { flex: none; width: 132rpx; min-height: 76rpx; margin: 0; padding: 0; color: #fff; background: #765d4b; border-radius: 10rpx; font-size: 21rpx; line-height: 76rpx; }
.ai-name-button::after { border: 0; }
.basic-summary-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; margin-top: 18rpx; padding-top: 10rpx; border-top: 1rpx solid #e7e4dd; }
.basic-summary-cell { display: flex; box-sizing: border-box; min-width: 0; min-height: 72rpx; padding: 10rpx 12rpx 10rpx 20rpx; flex-direction: column; justify-content: center; background: transparent; border: 0; border-radius: 0; }
.abv-summary { position: relative; }
.abv-summary::before { position: absolute; top: 8rpx; bottom: 8rpx; left: 0; width: 1rpx; background: #e7e4dd; content: ''; }
.basic-summary-label { color: #8a867f; font-size: 19rpx; line-height: 1.2; }
.basic-summary-value { min-width: 0; margin-top: 9rpx; overflow: hidden; color: #242321; font-size: 23rpx; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.basic-summary-value-line { display: flex; align-items: baseline; min-width: 0; margin-top: 9rpx; flex-wrap: wrap; gap: 6rpx; }
.abv-summary .basic-summary-value { margin-top: 0; color: #765d4b; font-size: 26rpx; font-weight: 650; }
.basic-abv-hint { display: inline; min-width: 0; margin-top: 0; color: #957052; font-size: 18rpx; line-height: 1.35; }
.basic-input, .sheet-search, .note-input { box-sizing: border-box; width: 100%; min-height: 60rpx; padding: 0 10rpx; color: #242321; background: #ffffff; border: 1rpx solid #e7e4dd; border-radius: 10rpx; font-size: 23rpx; }
.material-shortcuts { width: 100%; margin-top: 10rpx; }
.shortcut-track { display: flex; flex-wrap: wrap; gap: 6rpx; }
.edit-page .shortcut { width: auto; color: #6f6c66; background: #f1f0ec; }
.ingredient-list { margin-top: 4rpx; }
.material-stage-switch { display: flex; margin-top: 8rpx; padding: 0; border-bottom: 1rpx solid #e7e4dd; }
.edit-page .material-stage { position: relative; flex: 1; height: 62rpx; min-height: 62rpx; margin: 0; padding: 0; color: #9d9991; background: transparent; border-radius: 0; font-size: 24rpx; line-height: 62rpx; }
.material-stage.selected { color: #242321; font-weight: 650; }
.material-stage.selected::before { position: absolute; right: 0; bottom: -1rpx; left: 0; height: 4rpx; background: #242321; content: ''; }
.material-stage::after, .advance-add-material::after, .advance-card-delete::after, .add-advance::after { border: 0; }
.advance-pane { margin-top: 8rpx; }
.advance-card { box-sizing: border-box; margin-bottom: 10rpx; padding: 9rpx 8rpx 8rpx; background: #f1f0ec; border: 1rpx solid #e7e4dd; border-radius: 12rpx; }
.compact-label { display: block; margin: 12rpx 0 6rpx; color: #6f6c66; font-size: 21rpx; }
.advance-name, .advance-steps { box-sizing: border-box; width: 100%; padding: 0 12rpx; background: #ffffff; border: 1rpx solid #e7e4dd; border-radius: 10rpx; font-size: 23rpx; }
.advance-name { width: 100%; }
.prominent-name-input { box-sizing: border-box; height: 76rpx; min-height: 76rpx; padding: 0 14rpx; }
.advance-steps { height: 104rpx; padding: 8rpx; }
.advance-ingredients { margin-top: 5rpx; }
.advance-add-material, .advance-card-delete, .add-advance { margin: 0; font-size: 20rpx; }
.advance-material-shortcuts { margin: 7rpx 0 2rpx; }
.edit-page .advance-add-material { background: #ffffff; border-color: #e7e4dd; }
.advance-card-actions { display: flex; justify-content: flex-end; margin-top: 7rpx; }
.edit-page .advance-card-delete { display: inline-flex; align-items: center; justify-content: flex-end; width: auto; height: 48rpx; min-height: 48rpx; margin: 0; padding: 0; gap: 6rpx; color: #985a54; background: transparent; border-radius: 0; font-size: 20rpx; font-weight: 400; line-height: 48rpx; }
.advance-card-delete-icon { width: 24rpx; height: 24rpx; flex: none; }
.add-advance { display: inline-flex; align-items: center; justify-content: flex-start; width: auto; min-height: 38rpx; padding: 0; color: #957052; background: transparent; border: 0; border-radius: 0; line-height: 36rpx; text-align: left; }
.tool-scroll { margin-top: 14rpx; }
.tool-track { display: inline-flex; align-items: center; gap: 10rpx; padding-right: 16rpx; }
.tool-chip { display: inline-flex; align-items: center; min-height: 64rpx; padding: 0 18rpx; color: #6f6c66; background: #f1f0ec; border: 1rpx solid transparent; border-radius: 999rpx; font-size: 23rpx; }
.tool-chip.selected { color: #ffffff; background: #242321; }
.tool-chip.orphaned { color: #985a54; background: #f5ebe9; }
.tool-checkbox { width: 0; height: 0; margin: 0; opacity: 0; }
.missing-label { margin-left: 8rpx; font-size: 20rpx; font-weight: 700; }
.capacity-line { display: block; margin-top: 10rpx; color: #6f6c66; font-size: 23rpx; line-height: 1.5; }
.capacity-line.over, .capacity-line.incomplete { color: #985a54; font-weight: 600; }
.note-input { height: 96rpx; min-height: 96rpx; margin-top: 8rpx; padding: 8rpx 10rpx; line-height: 1.45; }
.warning, .error { display: block; margin-top: 10rpx; color: #985a54; font-size: 23rpx; line-height: 1.5; }
.bottom-space { height: calc(132rpx + env(safe-area-inset-bottom)); }
.save-bar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 10rpx 20rpx calc(10rpx + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, .96); box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, .07); }
.edit-page + .save-bar .save-button, .save-button { display: block; width: 360rpx; max-width: 100%; min-height: 72rpx; margin: 0 auto; color: #ffffff; background: #242321; border-radius: 14rpx; font-size: 26rpx; font-weight: 650; }
.save-error { margin: 0 0 8rpx; text-align: center; }
.mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(0, 0, 0, .38); }
.sheet { box-sizing: border-box; width: 100%; max-height: 72vh; padding: 18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); overflow: auto; background: #ffffff; border-radius: 34rpx 34rpx 0 0; }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; background: #e7e4dd; border-radius: 99rpx; }
.sheet-title { display: block; margin-bottom: 14rpx; color: #242321; font-size: 34rpx; font-weight: 700; }
.sheet-option { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 68rpx; margin: 0; padding: 0 4rpx; color: #6f6c66; background: transparent; border-bottom: 1rpx solid #f1f0ec; border-radius: 0; font-size: 24rpx; text-align: left; }
.other-base-option { color: #957052; }
.abv-hint { color: #6f6c66; font-size: 22rpx; }
.sheet-search { margin-bottom: 10rpx; }
.ai-mask { position: fixed; z-index: 30; inset: 0; display: flex; align-items: flex-end; background: rgba(0,0,0,.42); }
.ai-sheet { box-sizing: border-box; width: 100%; max-height: 86vh; padding: 24rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); overflow-y: auto; background: #fffefc; border-radius: 30rpx 30rpx 0 0; }
.ai-sheet-head { display: flex; align-items: center; justify-content: space-between; }.ai-sheet-title{color:#242321;font-size:32rpx;font-weight:700}
.ai-close { display: flex; width: 64rpx; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0; align-items: center; justify-content: center; color: #6f6c66; background: #f1f0ec; border-radius: 50%; font-size: 34rpx; line-height: 64rpx; }.ai-close::after,.ai-generate::after,.ai-result::after,.ai-settings::after{border:0}
.ai-sheet-copy { display: block; margin-top: 14rpx; color: #7e7972; font-size: 22rpx; line-height: 1.55; }
.ai-field-label { display: block; margin: 20rpx 0 8rpx; color: #544f49; font-size: 22rpx; }.ai-field,.ai-preference{box-sizing:border-box;width:100%;height:68rpx;padding:0 16rpx;background:#f6f4ef;border:1rpx solid #e7e4dd;border-radius:12rpx;font-size:23rpx}
.ai-thinking { display: flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 100rpx; margin-top: 18rpx; color: #765d4b; font-size: 24rpx; }.thinking-dot{width:16rpx;height:16rpx;background:#957052;border-radius:50%;animation:aiPulse 1s infinite}@keyframes aiPulse{50%{opacity:.3;transform:scale(.7)}}
.ai-error { display: block; margin-top: 16rpx; color: #985a54; font-size: 22rpx; text-align: center; }.ai-settings{width:220rpx;min-height:60rpx;margin:12rpx auto 0;color:#765d4b;background:#f1ede7;border-radius:999rpx;font-size:21rpx;line-height:60rpx}
.ai-results { width: 100%; margin-top: 20rpx; }.ai-results-title{display:block;margin-bottom:10rpx;color:#242321;font-size:24rpx;font-weight:700}.ai-result{display:block;box-sizing:border-box;width:100%;min-height:0;margin:10rpx 0 0;padding:18rpx;color:#242321;background:#f6f4ef;border:1rpx solid #e7e4dd;border-radius:14rpx;text-align:left;line-height:1.4}.ai-result-heading{display:flex;align-items:baseline;min-width:0;gap:8rpx}.ai-result-name,.ai-result-reason,.ai-result-use{display:block}.ai-result-name{min-width:0;font-size:28rpx;font-weight:700}.ai-result-artist{min-width:0;overflow:hidden;color:#817c74;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.ai-result-reason{margin-top:8rpx;color:#6f6c66;font-size:21rpx;white-space:normal}.ai-result-use{margin-top:10rpx;color:#957052;font-size:20rpx;text-align:right}
.ai-result-actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:12rpx}.ai-result-reject,.ai-result-actions .ai-result-use{width:auto;min-height:52rpx;margin:0;padding:0 16rpx;border-radius:999rpx;font-size:20rpx;line-height:52rpx}.ai-result-reject{color:#817c74;background:#ebe8e1}.ai-result-actions .ai-result-use{color:#fff;background:#8a6a52;text-align:center}.ai-result-reject::after,.ai-result-use::after,.ai-feedback-tag::after,.ai-feedback-submit::after{border:0}.ai-feedback{margin-top:14rpx;padding-top:14rpx;border-top:1rpx solid #e1ddd4}.ai-feedback-title{display:block;color:#3d3a35;font-size:22rpx;font-weight:600}.ai-feedback-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:10rpx}.ai-feedback-tag{width:auto;min-height:50rpx;margin:0;padding:0 15rpx;color:#6f6c66;background:#ebe8e1;border-radius:999rpx;font-size:19rpx;line-height:50rpx}.ai-feedback-tag.selected{color:#fff;background:#765d4b}.ai-feedback-note{box-sizing:border-box;width:100%;height:96rpx;min-height:96rpx;margin-top:12rpx;padding:12rpx 14rpx;background:#fff;border:1rpx solid #e3ded5;border-radius:10rpx;font-size:20rpx}.ai-feedback-error{display:block;margin-top:8rpx;color:#985a54;font-size:20rpx}.ai-feedback-submit{width:180rpx;min-height:54rpx;margin:12rpx 0 0 auto;color:#fff;background:#242321;border-radius:14rpx;font-size:21rpx;line-height:54rpx}
.ai-generate { box-sizing: border-box; width: 240rpx; height: 64rpx; min-height: 64rpx; margin: 20rpx auto 0; padding: 0 24rpx; color: #fff; background: #242321; border-radius: 18rpx; font-size: 25rpx; font-weight: 400; line-height: 64rpx; }
