<scroll-view class="page" scroll-y="true">
  <view class="section"><text class="title">基本信息</text><input data-field="name" value="{{form.name}}" placeholder="这杯酒叫什么？" bindinput="onBasicInput" /><input data-field="source" value="{{form.source}}" placeholder="来源（可选）" bindinput="onBasicInput" /><button bindtap="onChooseImage">选择图片（可选）</button><switch checked="{{form.tried}}" bindchange="onTried" /> <text>我喝过</text><text wx:if="{{errors.name}}" class="error">{{errors.name}}</text></view>
  <view class="section"><text class="title">材料</text><view class="quick-bases"><button wx:for="{{quickBases}}" wx:key="id" data-name="{{item.name}}" bindtap="onQuickBase">{{item.name}}</button></view><ingredient-row wx:for="{{formIngredients}}" wx:key="index" item="{{item}}" index="{{index}}" units="{{units}}" categories="{{categories}}" bind:change="onIngredientChange" bind:categorychange="onCategoryChange" bind:alcoholicchange="onAlcoholicChange" bind:remove="onRemoveIngredient" bind:pickname="onPickName" /><view class="quick-bases"><button wx:for="{{categories}}" wx:key="key" data-category="{{item.key}}" bindtap="onAddIngredient">＋{{item.label}}</button></view><text wx:if="{{errors.ingredients}}" class="error">{{errors.ingredients}}</text></view>
  <view class="section"><text class="title">制作方式</text><prep-editor preparations="{{formPreparations}}" types="{{prepTypes}}" bind:toggle="onTogglePrep" bind:change="onPrepChange" /><text wx:if="{{errors.preparations}}" class="error">{{errors.preparations}}</text></view>
  <view class="section"><text class="title">杯具与酒精度</text><picker range="{{glassware}}" range-key="name" bindchange="onGlassware"><view class="select">选择杯具</view></picker><checkbox-group bindchange="onTools"><label wx:for="{{tools}}" wx:key="id"><checkbox value="{{index}}" checked="{{item.selected}}" />{{item.name}}</label></checkbox-group><text class="abv">预估酒精度 {{preview.abvLabel}}%</text><text>液体 {{preview.liquidVolume}}ml</text><text wx:if="{{preview.capacityKnown}}">杯余量 {{preview.remaining}}ml / 容量 {{preview.capacity}}ml</text><text wx:if="{{preview.overCapacity}}" class="warning">超过杯具容量</text><view wx:if="{{preview.missing.length}}"><text class="warning">待补充：{{preview.missingText}}</text></view></view>
  <view class="section"><text class="title">步骤与评价</text><textarea data-field="steps" value="{{form.steps}}" placeholder="每行一个步骤" bindinput="onBasicInput" /><view class="ratings"><button wx:for="{{ratings}}" wx:key="*this" data-rating="{{item}}" bindtap="onRating">{{item}}</button></view><textarea data-field="tastingNote" value="{{form.tastingNote}}" placeholder="品鉴笔记（可选）" bindinput="onBasicInput" /></view>
  <view class="bottom-space"></view>
  <view wx:if="{{suggestionOpen}}" class="mask" bindtap="closeSuggestions"><view class="sheet" catchtap="noop"><text class="title">选择材料</text><input value="{{suggestionQuery}}" placeholder="搜索已有材料" bindinput="onSuggestionInput" /><button wx:for="{{suggestions}}" wx:key="index" data-index="{{index}}" bindtap="onChooseSuggestion">{{item.name}}</button></view></view>
</scroll-view>
<view class="save-bar"><button bindtap="onSave">保存配方</button></view>
