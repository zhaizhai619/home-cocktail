<view class="edit-page">
  <view class="section basic-section">
    <view class="section-heading">
      <text class="title">基本信息</text>
    </view>
    <view class="basic-grid">
      <view class="basic-fields">
        <view class="name-row">
          <input class="basic-input name-input prominent-name-input" data-field="name" value="{{form.name}}" placeholder="酒名" bindinput="onBasicInput" />
          <button class="ai-name-button" bindtap="onOpenAiNaming">AI 起名</button>
        </view>
      </view>
    </view>
    <view class="basic-status-row">
      <text class="basic-row-label">状态</text>
      <view class="tried-toggle">
        <button class="tried-option {{form.tried ? 'selected' : ''}}" data-tried="true" bindtap="onTriedTap">调过</button>
        <button class="tried-option {{!form.tried ? 'selected' : ''}}" data-tried="false" bindtap="onTriedTap">未调过</button>
      </view>
    </view>
    <view wx:if="{{form.tried}}" class="basic-rating-row">
      <text class="basic-row-label">评价</text>
      <view class="rating-track">
        <button wx:for="{{ratings}}" wx:key="*this" data-rating="{{item}}" bindtap="onRating" class="rating-chip {{form.rating === item ? 'selected' : ''}}" aria-label="{{item}}{{form.rating === item ? '，已选择' : ''}}">{{item}}</button>
      </view>
    </view>
    <view class="basic-summary-row">
      <view class="basic-summary-cell glassware-summary" bindtap="onOpenGlasswareSelect" aria-role="button" aria-label="选择酒杯，当前{{glasswareLabel}}">
        <text class="basic-summary-label">酒杯</text>
        <text class="basic-summary-value">{{glasswareLabel}}</text>
      </view>
      <view class="basic-summary-cell abv-summary">
        <text class="basic-summary-label">预估酒精度</text>
        <view class="basic-summary-value-line">
          <text class="basic-summary-value">{{preview.abvLabel}}{{preview.status === 'ok' ? '%' : ''}}</text>
          <text wx:if="{{preview.abvHint}}" class="abv-hint basic-abv-hint">{{preview.abvHint}}</text>
        </view>
      </view>
    </view>
    <text wx:if="{{errors.name}}" class="error">{{errors.name}}</text>
    <text wx:if="{{errors.equipment}}" class="error">{{errors.equipment}}</text>
  </view>

  <view class="section ingredient-section">
    <text class="title">材料</text>
    <view class="material-stage-switch">
      <button class="material-stage {{materialStage === 'serving' ? 'selected' : ''}}" data-stage="serving" bindtap="onMaterialStage">饮用时</button>
      <button class="material-stage {{materialStage === 'advance' ? 'selected' : ''}}" data-stage="advance" bindtap="onMaterialStage">提前准备</button>
    </view>
    <view wx:if="{{materialStage === 'serving'}}" class="material-shortcuts">
      <view class="shortcut-track">
        <button size="mini" class="shortcut" data-filter="base" bindtap="onOpenMaterialSelect">＋基酒</button>
        <button size="mini" class="shortcut" data-filter="liqueur" bindtap="onOpenMaterialSelect">＋利口酒</button>
        <button size="mini" class="shortcut" data-filter="produce" bindtap="onOpenMaterialSelect">＋果汁/果蔬</button>
        <button size="mini" class="shortcut" data-filter="mixer" bindtap="onOpenMaterialSelect">＋混合饮品</button>
        <button size="mini" class="shortcut" data-filter="spice" bindtap="onOpenMaterialSelect">＋香料</button>
        <button size="mini" class="shortcut" data-filter="all" bindtap="onOpenMaterialSelect">＋材料库</button>
      </view>
    </view>
    <view wx:if="{{materialStage === 'serving'}}" class="ingredient-list">
      <ingredient-row wx:for="{{formIngredients}}" wx:key="renderKey" item="{{item}}" index="{{index}}" units="{{units}}" dragging="{{draggingIngredientIndex === index}}" bind:change="onIngredientChange" bind:remove="onRemoveIngredient" bind:pickname="onPickName" bind:dragstart="onIngredientDragStart" bind:dragmove="onIngredientDragMove" bind:dragend="onIngredientDragEnd" />
    </view>
    <view wx:else class="advance-pane">
      <view wx:for="{{advanceCards}}" wx:for-item="preparation" wx:key="id" class="advance-card">
        <text class="compact-label">预调成品名称</text>
        <input class="advance-name prominent-name-input" data-preparation-id="{{preparation.id}}" data-field="outputName" value="{{preparation.outputName}}" bindinput="onAdvanceInput" />
        <view class="material-shortcuts advance-material-shortcuts">
          <view class="shortcut-track">
            <button size="mini" class="shortcut advance-add-material" data-stage="advance" data-preparation-id="{{preparation.id}}" data-index="-1" data-filter="base" bindtap="onOpenMaterialSelect">＋基酒</button>
            <button size="mini" class="shortcut advance-add-material" data-stage="advance" data-preparation-id="{{preparation.id}}" data-index="-1" data-filter="liqueur" bindtap="onOpenMaterialSelect">＋利口酒</button>
            <button size="mini" class="shortcut advance-add-material" data-stage="advance" data-preparation-id="{{preparation.id}}" data-index="-1" data-filter="produce" bindtap="onOpenMaterialSelect">＋果汁/果蔬</button>
            <button size="mini" class="shortcut advance-add-material" data-stage="advance" data-preparation-id="{{preparation.id}}" data-index="-1" data-filter="mixer" bindtap="onOpenMaterialSelect">＋混合饮品</button>
            <button size="mini" class="shortcut advance-add-material" data-stage="advance" data-preparation-id="{{preparation.id}}" data-index="-1" data-filter="spice" bindtap="onOpenMaterialSelect">＋香料</button>
            <button size="mini" class="shortcut advance-add-material" data-stage="advance" data-preparation-id="{{preparation.id}}" data-index="-1" data-filter="all" bindtap="onOpenMaterialSelect">＋材料库</button>
          </view>
        </view>
        <view class="ingredient-list advance-ingredients">
          <ingredient-row wx:for="{{preparation.formIngredients}}" wx:for-item="ingredient" wx:key="renderKey" item="{{ingredient}}" index="{{index}}" preparation-id="{{preparation.id}}" units="{{units}}" dragging="{{draggingAdvancePreparationId === preparation.id && draggingAdvanceIndex === index}}" bind:change="onAdvanceIngredientChange" bind:remove="onRemoveAdvanceIngredient" bind:pickname="onPickAdvanceName" bind:dragstart="onAdvanceDragStart" bind:dragmove="onAdvanceDragMove" bind:dragend="onAdvanceDragEnd" />
        </view>
        <text class="compact-label">提前准备步骤</text>
        <textarea class="advance-steps" data-preparation-id="{{preparation.id}}" data-field="steps" value="{{preparation.steps}}" bindinput="onAdvanceInput" />
        <view class="advance-card-actions">
          <button class="advance-card-delete" data-preparation-id="{{preparation.id}}" bindtap="onRemoveAdvancePreparation">
            <image class="advance-card-delete-icon" src="/assets/icons/trash-2.svg" mode="aspectFit" />
            <text>删除</text>
          </button>
        </view>
      </view>
      <button class="add-advance" bindtap="onCreateAdvancePreparation">＋ 添加提前准备</button>
    </view>
    <text wx:if="{{errors.ingredients}}" class="error">{{errors.ingredients}}</text>
    <text wx:if="{{errors.advancePreparation}}" class="error">{{errors.advancePreparation}}</text>
  </view>

  <view class="section">
    <text class="title">制作方式</text>
    <prep-editor preparations="{{formPreparations}}" types="{{prepTypeOptions}}" bind:toggle="onTogglePrep" bind:change="onPrepChange" />
    <text wx:if="{{errors.preparations}}" class="error">{{errors.preparations}}</text>
  </view>

  <view class="section note-section">
    <text class="title">备注与步骤</text>
    <textarea class="note-input" data-field="steps" value="{{form.steps}}" bindinput="onBasicInput" />
  </view>
  <view class="bottom-space"></view>
</view>

<view class="save-bar">
  <text wx:if="{{formError}}" class="error save-error" aria-live="assertive">{{formError}}</text>
  <button class="save-button {{savingRecipe ? 'is-disabled' : ''}}" disabled="{{savingRecipe}}" loading="{{savingRecipe}}" bindtap="onSave">{{savingRecipe ? '保存中…' : '保存配方'}}</button>
</view>

<view wx:if="{{aiNamingOpen}}" class="ai-mask" catchtap="onCloseAiNaming" catchtouchmove="noop">
  <view class="ai-sheet" catchtap="noop">
    <view class="ai-sheet-head"><text class="ai-sheet-title">用喜欢的歌给酒起名</text><button size="mini" class="ai-close" disabled="{{aiThinking}}" bindtap="onCloseAiNaming" aria-label="关闭">×</button></view>
    <text class="ai-sheet-copy">AI 会结合材料和用量理解这杯酒。颜色和起名偏好可以不填，但能帮助结果更贴近你的想法。</text>
    <text class="ai-field-label">酒的颜色</text>
    <input class="ai-field" value="{{aiColor}}" data-field="aiColor" bindinput="onAiFieldInput" />
    <text class="ai-field-label">起名偏好</text>
    <input class="ai-preference" value="{{aiPreference}}" data-field="aiPreference" bindinput="onAiFieldInput" />

    <view wx:if="{{aiThinking}}" class="ai-thinking"><view class="thinking-dot"></view><text>{{aiThinkingText}}</text></view>
    <text wx:if="{{aiError}}" class="ai-error">{{aiError}}</text>
    <button wx:if="{{aiNeedsSetup}}" class="ai-settings" bindtap="onOpenMusicSettings">前往配置</button>

    <view wx:if="{{aiRecommendations.length}}" class="ai-results">
      <text class="ai-results-title">推荐酒名</text>
      <view wx:for="{{aiRecommendations}}" wx:key="song_id" class="ai-result">
        <view class="ai-result-heading"><text class="ai-result-name">{{item.recommended_name}}</text><text wx:if="{{item.artist}}" class="ai-result-artist">· {{item.artist}}</text></view>
        <text class="ai-result-reason">{{item.reason}}</text>
        <view class="ai-result-actions">
          <button class="ai-result-reject" data-song-id="{{item.song_id}}" bindtap="onOpenAiFeedback">不合适</button>
          <button class="ai-result-use" data-song-id="{{item.song_id}}" bindtap="onUseAiName">使用这个名字</button>
        </view>
        <view wx:if="{{aiFeedbackSongId === item.song_id}}" class="ai-feedback">
          <text class="ai-feedback-title">哪里不太合适？</text>
          <view class="ai-feedback-tags">
            <button wx:for="{{aiFeedbackOptions}}" wx:key="key" class="ai-feedback-tag {{item.selected ? 'selected' : ''}}" data-tag="{{item.key}}" bindtap="onToggleAiFeedbackTag">{{item.label}}</button>
          </view>
          <textarea class="ai-feedback-note" maxlength="120" value="{{aiFeedbackNote}}" bindinput="onAiFeedbackNoteInput" placeholder="还可以补充一句（选填）" />
          <text wx:if="{{aiFeedbackError}}" class="ai-feedback-error">{{aiFeedbackError}}</text>
          <button class="ai-feedback-submit" disabled="{{aiFeedbackSubmitting}}" loading="{{aiFeedbackSubmitting}}" bindtap="onSubmitAiFeedback">提交反馈</button>
        </view>
      </view>
    </view>
    <button class="ai-generate" disabled="{{aiThinking}}" loading="{{aiThinking}}" bindtap="onGenerateAiNames">{{aiRecommendations.length ? '重新生成' : '开始匹配'}}</button>
  </view>
</view>
