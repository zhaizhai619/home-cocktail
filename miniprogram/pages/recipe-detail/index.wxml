<view class="page detail-page">
  <view wx:if="{{detail.status === 'missing'}}" class="empty-state">
    <text class="empty-title">这款酒找不到了</text>
    <text class="empty-copy">{{detail.message}}</text>
    <button class="primary-button" bindtap="onBackToList">返回我的酒单</button>
  </view>

  <block wx:elif="{{detail.status === 'ok'}}">
    <image wx:if="{{detail.imagePath}}" class="hero-image" src="{{detail.imagePath}}" mode="aspectFill" />
    <view class="hero-card">
      <view class="hero-heading"><text class="recipe-name">{{detail.name}}</text><text wx:if="{{detail.rating}}" class="rating-badge">{{detail.rating}}</text></view>
      <text wx:if="{{detail.source}}" class="muted">来源：{{detail.source}}</text>
      <view class="prep-list">
        <view wx:for="{{detail.preparations}}" wx:key="type" class="prep-item">
          <text class="prep-badge">{{item.label}}</text>
          <text wx:if="{{item.note}}" class="prep-note">{{item.note}}</text>
        </view>
      </view>
      <view class="summary-grid">
        <view class="summary-item"><text class="summary-label">预估酒精度</text><text class="summary-value">{{detail.abv.valueLabel}}</text></view>
        <view class="summary-item"><text class="summary-label">预计总体积</text><text class="summary-value">{{detail.abv.liquidVolumeLabel}}</text><text wx:if="{{detail.abv.knownLiquidVolumeText}}" class="known-volume">{{detail.abv.knownLiquidVolumeText}}</text></view>
      </view>
      <text class="capacity-summary {{detail.capacity.status}}">{{detail.capacity.message}}</text>
      <text wx:if="{{detail.capacity.status === 'over'}}" class="capacity-warning">容量提醒：预计超出 {{detail.capacity.differenceMl}}ml</text>
      <view wx:if="{{detail.abv.issueLines.length || detail.abv.ignoredText}}" class="calculation-notice">
        <text wx:for="{{detail.abv.issueLines}}" wx:key="kind" class="calculation-line {{item.kind}}">{{item.text}}</text>
        <text wx:if="{{detail.abv.ignoredText}}" class="calculation-line ignored">{{detail.abv.ignoredText}}</text>
        <button wx:if="{{detail.abv.editMaterialId}}" class="inline-edit-button" bindtap="onEditMissingAbv">去编辑补全</button>
        <button wx:elif="{{detail.abv.needsEditing}}" class="inline-edit-button" bindtap="onEdit">编辑配方</button>
      </view>
    </view>

    <view class="section">
      <text class="section-title">材料</text>
      <view class="ingredient-list">
        <view wx:for="{{detail.ingredients}}" wx:key="index" class="ingredient-row {{item.state}}" data-id="{{item.materialId}}" bindtap="onOpenMaterial" aria-label="{{item.accessibilityLabel}}">
          <view class="ingredient-main"><text wx:if="{{item.state === 'quick-buy'}}" class="quick-buy-icon" aria-hidden="true">🛍</text><text class="ingredient-name">{{item.name}}</text></view>
          <view class="ingredient-side"><text class="ingredient-amount">{{item.amountLabel}}</text><text wx:if="{{!item.prepared}}" class="row-arrow" aria-hidden="true">›</text></view>
        </view>
      </view>
    </view>

    <view wx:for="{{detail.advancePreparations}}" wx:for-item="preparation" wx:key="id" class="section">
      <text class="section-title">提前准备 · {{preparation.outputName}}</text>
      <view class="ingredient-list"><view wx:for="{{preparation.ingredients}}" wx:for-item="ingredient" wx:key="index" class="ingredient-row {{ingredient.state}}" data-id="{{ingredient.materialId}}" bindtap="onOpenMaterial"><text class="ingredient-name">{{ingredient.name}}</text><text class="ingredient-amount">{{ingredient.amountLabel}}</text></view></view>
      <view wx:if="{{preparation.steps.length}}" class="steps"><view wx:for="{{preparation.steps}}" wx:for-item="step" wx:key="index" class="step"><text class="step-index">{{index + 1}}</text><text class="step-copy">{{step}}</text></view></view>
    </view>

    <view class="section">
      <text class="section-title">酒杯与用具</text>
      <view wx:if="{{detail.glassware}}" class="glass-card {{detail.glassware.orphaned ? 'orphaned' : ''}}"><image wx:if="{{detail.glassware.imagePath}}" class="glass-image" src="{{detail.glassware.imagePath}}" mode="aspectFill" /><view class="glass-copy"><view class="equipment-line"><text>酒杯</text><text>{{detail.glassware.name}} {{detail.glassware.capacityLabel}}</text></view><text wx:if="{{detail.glassware.notes}}" class="muted">{{detail.glassware.notes}}</text><text wx:if="{{detail.glassware.orphaned}}" class="orphan-label">资料缺失，请编辑配方重新选择</text></view></view>
      <view wx:if="{{detail.tools.length}}" class="tool-list"><text wx:for="{{detail.tools}}" wx:key="id" class="tool-chip {{item.orphaned ? 'orphaned' : ''}}">{{item.name}}<text wx:if="{{item.orphaned}}"> · 资料缺失</text></text></view>
      <text wx:if="{{!detail.glassware && !detail.tools.length}}" class="muted">暂未记录酒杯和用具</text>
    </view>

    <view class="section">
      <text class="section-title">制作步骤</text>
      <view wx:if="{{detail.steps.length}}" class="steps"><view wx:for="{{detail.steps}}" wx:key="index" class="step"><text class="step-index">{{index + 1}}</text><text class="step-copy">{{item}}</text></view></view>
      <text wx:else class="muted">暂未记录制作步骤</text>
    </view>

    <view class="section">
      <text class="section-title">我的评价</text>
      <view class="ratings"><text wx:for="{{detail.ratings}}" wx:key="label" data-rating="{{item.label}}" bindtap="onToggleRating" class="rating-option {{item.selected ? 'selected' : ''}}" aria-role="button" aria-label="{{item.label}}{{item.selected ? '，已选择，再点取消' : '，点按评价'}}"><text wx:if="{{item.selected}}" class="selected-mark">✓</text>{{item.label}}</text></view>
    </view>

    <view class="section">
      <text class="section-title">材料观察</text>
      <view wx:if="{{detail.observations.length}}" class="observation-list">
        <view wx:for="{{detail.observations}}" wx:key="index" class="observation-item"><view class="observation-heading"><text>{{item.materialName}}</text><text wx:if="{{item.createdAtLabel}}" class="muted">{{item.createdAtLabel}}</text></view><text class="observation-note">{{item.note}}</text></view>
      </view>
      <text wx:else class="muted">还没有针对单个材料的记录</text>
      <view wx:if="{{detail.ingredientOptions.length}}" class="observation-form">
        <picker range="{{detail.ingredientOptions}}" range-key="name" value="{{observationMaterialIndex}}" bindchange="onObservationMaterialChange"><view class="picker-field">{{observationMaterialLabel}} ▾</view></picker>
        <textarea value="{{observationNote}}" maxlength="300" placeholder="这次用这个材料，有什么新发现？" bindinput="onObservationInput" />
        <text wx:if="{{observationError}}" class="form-error">{{observationError}}</text>
        <button class="secondary-button" bindtap="onSaveObservation">保存本次观察</button>
      </view>
    </view>

    <view class="bottom-space"></view>
    <view class="action-bar"><button class="action-button edit" bindtap="onEdit">编辑</button><button class="action-button delete" bindtap="onDelete">删除</button></view>
  </block>
</view>
