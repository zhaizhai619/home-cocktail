.detail-page{padding:32rpx 28rpx 160rpx}
.hero{padding:28rpx 28rpx 18rpx;background:#ffffff;border:1rpx solid #e7e4dd;border-radius:32rpx}
.hero-top,.availability-row,.tracking-row,.numbers,.observation-heading{display:flex;align-items:center}
.hero-top,.availability-row,.tracking-row{justify-content:space-between}
.title{display:block;font-size:42rpx;font-weight:700}
.edit.edit{width:auto;height:64rpx;min-height:64rpx;margin:0;padding:0 20rpx;color:#ffffff;background:#242321;border-radius:999rpx;font-size:23rpx;line-height:64rpx}
.availability-row,.tracking-row{min-height:76rpx;margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid rgba(0, 0, 0,.15)}
.availability-row>view,.tracking-row>view{flex:1;min-width:0;padding-right:16rpx}
.availability-row switch,.tracking-row switch{flex:none}
.availability-title,.availability-note{display:block}
.availability-title{font-size:27rpx;font-weight:600}
.availability-note{margin-top:5rpx;color:#6f6c66;font-size:21rpx}
.tracking-details{margin-top:18rpx;border-top:1rpx solid rgba(0, 0, 0,.15)}
.tracking-detail-row{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;min-height:88rpx;padding:0 8rpx;border-bottom:1rpx solid #f1f0ec}
.tracking-detail-row:last-of-type{border-bottom:0}
.tracking-detail-label{flex:none;color:#6f6c66;font-size:24rpx;line-height:1}
.tracking-detail-control{display:flex;align-items:center;justify-content:flex-end;height:88rpx;min-width:0;margin-left:auto}
.tracking-value-picker{display:flex;align-items:center;justify-content:flex-end;box-sizing:border-box;height:88rpx;min-height:88rpx}
.tracking-detail-value{display:flex;align-items:center;justify-content:flex-end;box-sizing:border-box;height:88rpx;padding:0 6rpx;color:#242321;font-size:24rpx;font-weight:600;line-height:1;text-align:right}
.tracking-amount-control{gap:8rpx}
.tracking-amount-input{box-sizing:border-box;width:170rpx;height:88rpx;min-height:88rpx;padding:0 4rpx;color:#242321;background:transparent;border:0;font-size:24rpx;font-weight:600;line-height:88rpx;text-align:right}
.tracking-unit-picker{display:flex;align-items:center;justify-content:flex-end;box-sizing:border-box;height:88rpx;min-height:88rpx}
.tracking-unit-value{display:flex;align-items:center;justify-content:flex-end;box-sizing:border-box;min-width:58rpx;height:88rpx;color:#6f6c66;font-size:24rpx;line-height:1}
.tracking-error{display:block;padding:0 8rpx 14rpx;color:#985a54;font-size:21rpx;text-align:right}
.numbers{margin:22rpx 0;padding:26rpx;background:#ffffff;border:1rpx solid #e7e4dd;border-radius:26rpx;color:#242321}
.numbers view{flex:1;text-align:center}
.numbers view+view{border-left:1rpx solid #e7e4dd}
.number,.number-label{display:block}
.number{font-size:44rpx;font-weight:700;color:#242321}
.number-label{font-size:22rpx;color:#9d9991;margin-top:5rpx}
.section{margin-top:32rpx}
.section-title{display:block;font-size:34rpx;font-weight:700}
.note-card{margin-top:0;padding:26rpx;background:#ffffff;border:1rpx solid #e7e4dd;border-radius:25rpx}
.note{display:block;font-size:27rpx;line-height:1.6}
.note-source{display:block;margin-top:12rpx;color:#6f6c66;font-size:21rpx}
.observation-swipe{position:relative;overflow:hidden;margin-top:18rpx;border-radius:25rpx;background:transparent}
.observation-swipe-content{position:relative;z-index:2;transition:transform .2s ease;will-change:transform}
.observation-swipe.open .observation-swipe-content{transform:translateX(-256rpx)}
.observation-actions{position:absolute;z-index:1;top:0;right:0;bottom:0;display:flex;width:244rpx;gap:12rpx}
.observation-edit{display:flex;box-sizing:border-box;width:116rpx;align-items:center;justify-content:center;color:#3f4144;background:#ffffff;border:1rpx solid #d8d5cf;border-radius:18rpx;font-size:25rpx;font-weight:400;line-height:1}
.observation-delete{display:flex;box-sizing:border-box;width:116rpx;align-items:center;justify-content:center;color:#985a54;background:#f6e3df;border:1rpx solid #e5bbb5;border-radius:18rpx;font-size:25rpx;font-weight:400;line-height:1}
.empty,.missing{margin-top:20rpx;padding:44rpx 24rpx;text-align:center;color:#6f6c66;background:#ffffff;border:1rpx dashed #e7e4dd;border-radius:24rpx}
.missing{margin:100rpx 0}
.missing button{margin-top:24rpx;background:#242321;color:#ffffff}
.undo-bar{position:fixed;z-index:20;left:28rpx;right:28rpx;bottom:40rpx;padding:16rpx 18rpx 16rpx 26rpx;display:flex;align-items:center;justify-content:space-between;background:#242321;color:#ffffff;border-radius:22rpx}
.undo-bar button{margin:0;color:#ffffff;background:transparent;font-size:25rpx}
.detail-page button::after{border:0}
.observation-heading{justify-content:space-between;width:100%;gap:14rpx}
.observations .section-title{font-weight:400}
.add-observation.add-observation{width:auto;height:58rpx;min-height:58rpx;margin:0;padding:0 18rpx;background:#242321;color:#ffffff;border-radius:999rpx;font-size:22rpx;line-height:58rpx}
.material-observation-form{box-sizing:border-box;margin-top:16rpx;padding:14rpx;background:#ffffff;border:1rpx solid #e7e4dd;border-radius:18rpx}
.material-observation-form textarea{box-sizing:border-box;width:100%;height:96rpx;min-height:96rpx;padding:8rpx 4rpx;background:transparent;border:0;border-radius:0;font-size:24rpx;line-height:1.5}
.observation-form-footer{min-height:52rpx;margin-top:12rpx;display:flex;align-items:center;justify-content:flex-end;gap:12rpx}
.observation-form-footer .form-error{flex:1;color:#985a54;font-size:21rpx}
.cancel-observation.cancel-observation,.save-observation.save-observation{box-sizing:border-box;width:104rpx;height:52rpx;min-height:52rpx;margin:0;padding:0;border-radius:999rpx;font-size:22rpx;line-height:52rpx}
.cancel-observation.cancel-observation{color:#6f6c66;background:#f1f0ec}
.save-observation.save-observation{color:#ffffff;background:#242321}
