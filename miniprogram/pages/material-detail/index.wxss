.detail-page{padding:32rpx 28rpx 160rpx}.hero{padding:32rpx;background:linear-gradient(145deg,#fffaf0,#f0dcc0);border:1rpx solid #e5c99f;border-radius:32rpx}.hero-top,.status-actions,.inventory,.numbers,.recipe-title-row,.amount-row{display:flex;align-items:center}.hero-top,.recipe-title-row{justify-content:space-between}.eyebrow{display:block;font-size:19rpx;letter-spacing:4rpx;color:#a96826}.title{display:block;margin-top:8rpx;font-size:46rpx;font-weight:700}.edit{margin:0;background:rgba(255,255,255,.65);font-size:24rpx;line-height:64rpx;border-radius:999rpx;padding:0 26rpx}.status-actions{gap:14rpx;margin-top:28rpx}.status{margin:0;line-height:64rpx;border-radius:999rpx;font-size:24rpx;background:#ede6dd;color:#746a61;padding:0 28rpx}.status.active{background:#dfe9dc;color:#456042}.status.warm{background:#e9c68e;color:#6f4618}.status.danger{background:#fff7f3;color:#9a4c38;border:1rpx solid #dbb3a6}.inventory{justify-content:space-between;margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid rgba(121,85,42,.15);font-size:25rpx;color:#6f5b43}.numbers{margin:22rpx 0;padding:26rpx;background:#342f2b;border-radius:26rpx;color:#fff}.numbers view{flex:1;text-align:center}.numbers view+view{border-left:1rpx solid #625b54}.number,.number-label{display:block}.number{font-size:44rpx;font-weight:700;color:#f1bd78}.number-label{font-size:22rpx;color:#d3ccc4;margin-top:5rpx}.section{margin-top:40rpx}.section-title{display:block;font-size:34rpx;font-weight:700}.section-note{display:block;margin-top:6rpx;color:#8d8278;font-size:23rpx}.recipe-card,.note-card{margin-top:18rpx;padding:26rpx;background:#fffdf8;border:1rpx solid #e8ddcf;border-radius:25rpx}.recipe-image{display:block;width:100%;height:250rpx;margin-bottom:22rpx;border-radius:18rpx;background:#eee5d8}.recipe-content{width:100%}.recipe-title{font-size:30rpx;font-weight:700}.prep{font-size:21rpx;padding:7rpx 14rpx;background:#eee2d2;color:#805729;border-radius:999rpx}.ingredients{margin-top:18rpx;line-height:1.8}.ingredient{font-size:24rpx;color:#4d4741}.ingredient.state-quick-buy{color:#a66c28}.ingredient.state-missing-long-term{color:#9b9690}.recipe-meta{margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid #eee5d9}.recipe-meta text{display:block;margin-top:6rpx;font-size:22rpx;color:#80766d}.note{display:block;font-size:27rpx;line-height:1.6}.note-source{display:block;margin-top:12rpx;color:#9a8e82;font-size:21rpx}.empty,.missing{margin-top:20rpx;padding:44rpx 24rpx;text-align:center;color:#8d8379;background:#fffaf3;border:1rpx dashed #ded0be;border-radius:24rpx}.missing{margin:100rpx 0}.missing button{margin-top:24rpx;background:#342f2b;color:#fff}.sheet-mask{position:fixed;z-index:10;inset:0;background:rgba(32,27,23,.38);display:flex;align-items:flex-end}.sheet{box-sizing:border-box;width:100%;padding:18rpx 32rpx 54rpx;background:#fffaf2;border-radius:36rpx 36rpx 0 0}.sheet-handle{width:72rpx;height:8rpx;margin:0 auto 26rpx;border-radius:8rpx;background:#d3c7b8}.sheet-title{display:block;font-size:34rpx;font-weight:700}.field-label{display:block;margin:22rpx 0 10rpx;font-size:24rpx}.tracking-note{display:block;margin-top:22rpx;padding:24rpx;background:#f5eee4;border-radius:18rpx;color:#766c62;font-size:24rpx;line-height:1.6}.amount-row{gap:16rpx}.amount-row input,.picker{box-sizing:border-box;height:80rpx;padding:22rpx;background:#fff;border:1rpx solid #e5d8c7;border-radius:18rpx}.amount-row input{flex:1}.picker{min-width:150rpx}.picker.full{width:100%}.primary{margin-top:32rpx;background:#342f2b;color:#fff}.undo-bar{position:fixed;z-index:20;left:28rpx;right:28rpx;bottom:40rpx;padding:16rpx 18rpx 16rpx 26rpx;display:flex;align-items:center;justify-content:space-between;background:#342f2b;color:#fff;border-radius:22rpx}.undo-bar button{margin:0;color:#f2bd78;background:transparent;font-size:25rpx}.detail-page button::after{border:0}
