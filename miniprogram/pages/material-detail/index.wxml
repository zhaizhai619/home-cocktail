<view class="detail-page">
  <view wx:if="{{detail.status === 'missing'}}" class="missing"><text>{{detail.message}}</text><button bindtap="onBack">返回</button></view>
  <block wx:else>
    <view class="hero">
      <view class="hero-top"><view><text class="eyebrow">MATERIAL</text><text class="title">{{detail.name}}</text></view><button class="edit" bindtap="onEdit">编辑</button></view>
      <view class="availability-row"><view><text class="availability-title">当前我有</text><text class="availability-note">关闭后，酒单中的相关材料会显示为缺少</text></view><switch checked="{{detail.available}}" bindchange="onToggleAvailable" color="#6d8666"/></view>
      <view wx:if="{{detail.canToggleTracking}}" class="tracking-row"><view><text class="availability-title">追踪数量与保质期</text><text class="availability-note">可以记录余量、购买日期和预计过期日</text></view><switch checked="{{detail.trackFreshness}}" bindchange="onToggleTracking" color="#a96826"/></view>
      <view class="status-actions"><button wx:if="{{detail.canEditTracking}}" class="status warm" bindtap="onOpenTrackingForm">更新追踪信息</button></view>
      <view wx:if="{{detail.inventoryLabel || detail.expiryLabel}}" class="inventory"><text>{{detail.inventoryLabel}}</text><text wx:if="{{detail.expiryLabel}}">{{detail.expiryLabel}}</text></view>
      <view wx:if="{{detail.canEditPurchasedAt}}" class="purchase-row">
        <text class="purchase-label">购买日期</text>
        <view class="purchase-actions"><button wx:if="{{detail.purchasedAtDate && !detail.trackFreshness}}" class="purchase-clear" bindtap="onClearPurchaseDate">清除</button><picker mode="date" value="{{detail.purchasedAtDate}}" bindchange="onPurchaseDateChange"><view class="purchase-value">{{detail.purchasedAtDate || '未填写'}} ›</view></picker></view>
      </view>
    </view>

    <view class="numbers">
      <view><text class="number">{{detail.usageCount}}</text><text class="number-label">款酒使用</text></view>
      <view><text class="number">{{detail.immediateUnlockCount}}</text><text class="number-label">买后立即解锁</text></view>
    </view>

    <view class="section observations">
      <text class="section-title">我的材料观察</text>
      <view class="material-observation-form">
        <textarea value="{{observationNote}}" maxlength="300" placeholder="记录这个材料的新发现" bindinput="onObservationInput"/>
        <view class="observation-form-footer"><text wx:if="{{observationError}}" class="form-error">{{observationError}}</text><button class="save-observation" bindtap="onSaveObservation">保存观察</button></view>
      </view>
      <view wx:if="{{detail.observations.length}}">
        <view wx:for="{{detail.observations}}" wx:key="index" class="note-card">
          <text class="note">“{{item.note}}”</text><text wx:if="{{item.direct}}" class="note-source">记录于 {{item.createdAt || '未记录日期'}}</text><text wx:else class="note-source">来自 {{item.recipeName || '未命名酒款'}} · {{item.createdAt || '未记录日期'}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{showFreshForm}}" class="sheet-mask" bindtap="onCloseFreshForm"><view class="sheet" catchtap="noop">
    <view class="sheet-handle"></view><text class="sheet-title">更新追踪信息</text>
    <block wx:if="{{freshDraft.trackFreshness}}"><text class="field-label">还剩多少（选填）</text><view class="amount-row"><input type="digit" value="{{freshDraft.remainingAmount}}" bindinput="onFreshAmountInput" placeholder="例如 320"/><picker range="{{unitLabels}}" value="{{freshUnitIndex}}" bindchange="onFreshUnitChange"><view class="picker">{{unitLabels[freshUnitIndex]}}</view></picker></view>
      <text class="field-label">预计过期日（选填）</text><picker mode="date" value="{{freshDraft.expiresAt}}" bindchange="onFreshExpiryChange"><view class="picker full">{{freshDraft.expiresAt || '选择日期'}}</view></picker></block>
    <text wx:if="{{freshError}}" class="form-error">{{freshError}}</text><button class="primary" bindtap="onConfirmTracking">保存追踪信息</button>
  </view></view>
  <view wx:if="{{undo}}" class="undo-bar"><text>已从手头鲜材移出</text><button bindtap="onUndoUseUp">撤销</button></view>
</view>
