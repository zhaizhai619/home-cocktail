.edit-page{padding:36rpx 28rpx 100rpx}.heading{margin-bottom:28rpx}.eyebrow{display:block;font-size:19rpx;letter-spacing:4rpx;color:#242321}.title{display:block;margin-top:8rpx;font-size:44rpx;font-weight:700}.intro{display:block;margin-top:10rpx;color:#6f6c66;font-size:24rpx}.form-card{margin-bottom:18rpx;padding:28rpx;background:#ffffff;border:1rpx solid #e7e4dd;border-radius:26rpx}.label{display:block;margin:24rpx 0 10rpx;color:#6f6c66;font-size:23rpx}.label:first-child{margin-top:0}.input,.picker,.suffix-input,.amount-row{box-sizing:border-box;min-height:80rpx;background:#ffffff;border:1rpx solid #e7e4dd;border-radius:18rpx}.input{width:100%;padding:20rpx;font-size:27rpx}.picker{padding:22rpx;display:flex;justify-content:space-between;font-size:25rpx}.two-columns{display:flex;gap:18rpx}.two-columns>view{flex:1;min-width:0}.switch-row{display:flex;align-items:center;justify-content:space-between;min-height:96rpx}.switch-row+.switch-row{border-top:1rpx solid #f1f0ec}.switch-title,.switch-note{display:block}.switch-title{font-size:27rpx;font-weight:600}.switch-note{margin-top:5rpx;font-size:21rpx;color:#6f6c66}.tracking-hint{display:block;padding:20rpx;background:#f1f0ec;border-radius:16rpx;color:#6f6c66;font-size:22rpx}.suffix-input,.amount-row{display:flex;align-items:center;padding:0 20rpx}.suffix-input input,.amount-row input{flex:1;font-size:27rpx}.amount-row{padding-right:0}.unit-picker{min-width:130rpx;padding:22rpx;border-left:1rpx solid #e7e4dd;text-align:center}.error{border-color:#985a54}.error-text{display:block;margin-top:8rpx;color:#985a54;font-size:21rpx}.form-actions{display:flex;align-items:stretch;gap:16rpx;margin-top:30rpx}.form-actions button{box-sizing:border-box;width:0;margin:0;border-radius:22rpx;line-height:92rpx}.form-actions .save{flex:1;background:#242321;color:#ffffff;font-size:29rpx}.form-actions .delete{flex:1;background:#f5ebe9;color:#985a54;border:1rpx solid #e5cfca;font-size:27rpx}.missing{margin-top:100rpx;padding:50rpx 24rpx;text