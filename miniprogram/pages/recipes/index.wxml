<view class="page">
  <view class="topbar"><text class="page-title">我的酒单</text><button class="add-button" bindtap="onAddRecipe" aria-label="添加一款酒">＋ 添加</button></view>
  <input class="search" placeholder="搜索酒名或材料" value="{{search}}" bindinput="onSearchInput" aria-label="搜索酒名或材料" />
  <scroll-view class="prep-scroll" scroll-x="true"><view class="prep-chips"><button wx:for="{{prepChips}}" wx:key="key" data-key="{{item.key}}" bindtap="onSelectPrep" class="chip {{prepType === item.key ? 'active' : ''}}" aria-label="{{item.label}}{{prepType === item.key ? '，已选择' : ''}}">{{prepType === item.key ? '✓' : ''}} {{item.label}}</button></view></scroll-view>
  <view class="controls"><button class="material-filter" bindtap="openMaterialSheet" aria-label="材料条件，当前{{materialConditionLabel}}">材料：{{materialConditionLabel}} ▾</button><scroll-view class="sort-scroll" scroll-x="true"><view class="sort-list"><button wx:for="{{sortOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="onSelectSort" class="sort-button {{sortKey === item.key ? 'active' : ''}}" aria-label="{{item.label}}{{sortKey === item.key ? '，已选择' : ''}}"><text wx:if="{{sortKey === item.key}}" class="selected-mark">✓</text>{{item.label}}</button></view></scroll-view></view>
  <view wx:if="{{recipes.length}}" class="card-list"><recipe-card wx:for="{{recipes}}" wx:key="id" recipe="{{item}}" bind:select="onSelectRecipe" /></view>
  <view wx:else class="empty"><text class="empty-title">还没有收藏的酒</text><text class="empty-copy">从第一款常喝的酒开始，慢慢搭建自己的酒单。</text><button class="empty-button" bindtap="onAddRecipe">录入我的第一款酒</button></view>
  <view wx:if="{{showMaterialSheet}}" class="sheet-mask" bindtap="closeMaterialSheet"><view class="sheet" catchtap="noop"><text class="sheet-title">材料条件</text><button wx:for="{{materialOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="onSelectMaterial" class="condition-option {{materialCondition === item.key ? 'selected' : ''}}" aria-label="{{item.label}}{{materialCondition === item.key ? '，已选择' : ''}}"><text>{{item.label}}</text><text wx:if="{{materialCondition === item.key}}">✓</text></button></view></view>
</view>
