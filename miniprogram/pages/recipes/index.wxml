<view class="page recipes-page {{filterPanelOpen ? 'filter-open' : ''}}">
  <view class="menu-source-tabs" aria-label="酒单来源">
    <view class="menu-source-tab {{activeSource === 'mine' ? 'selected' : ''}}" data-source="mine" bindtap="onSelectSource" aria-role="button" aria-label="我的酒单{{activeSource === 'mine' ? '，已选择' : ''}}">我的酒单</view>
    <view class="menu-source-tab {{activeSource === 'shared' ? 'selected' : ''}}" data-source="shared" bindtap="onSelectSource" aria-role="button" aria-label="好友分享{{activeSource === 'shared' ? '，已选择' : ''}}">好友分享</view>
  </view>

  <block wx:if="{{activeSource === 'mine'}}">
  <view class="ai-naming-banner" bindtap="onOpenMusicNaming" aria-role="button" aria-label="体验智能酒名功能">
    <view class="ai-banner-copy">
      <view class="ai-banner-title-row"><text class="ai-badge">体验版</text><text class="ai-banner-title">用喜欢的歌，为鸡尾酒起名</text></view>
      <text class="ai-banner-hint">先导入网易云红心歌曲，添加酒品时即可智能匹配</text>
    </view>
    <text class="ai-banner-arrow">›</text>
  </view>
  <view class="search-box">
    <text class="search-icon" aria-hidden="true">⌕</text>
    <input class="search-input" placeholder="搜索酒名或材料" value="{{search}}" bindinput="onSearchInput" aria-label="搜索酒名或材料" />
  </view>
  <text wx:if="{{seasonalFruitMessage}}" class="seasonal-fruit-tip">{{seasonalFruitMessage}}</text>

  <view class="filter-bar">
    <view class="filter-trigger" bindtap="toggleFilterPanel" aria-role="button" aria-expanded="{{filterPanelOpen}}" aria-label="全部筛选，{{loadingRecipes ? '酒单加载中' : '当前显示'}}{{loadingRecipes ? '' : recipes.length}}{{loadingRecipes ? '' : '款酒'}}，{{filterPanelOpen ? '已展开' : '已收起'}}">
      <text class="filter-trigger-label">全部</text>
      <view class="filter-symbol {{prepType !== 'all' || materialCondition !== 'all' || rating !== 'all' || triedStatus !== 'all' || sortKey !== 'recent' ? 'active' : ''}}" aria-hidden="true">
        <view class="filter-symbol-line line-long"></view>
        <view class="filter-symbol-line line-medium"></view>
        <view class="filter-symbol-line line-short"></view>
      </view>
      <text class="recipe-count">{{loadingRecipes ? '…' : recipes.length}}</text>
    </view>
    <button size="mini" class="add-hit" bindtap="onAddRecipe" aria-label="添加一款酒">＋ 新增</button>
  </view>

  <view wx:if="{{filterPanelOpen}}" class="filter-scroll-lock" catchtap="collapseFilterPanel" catchtouchmove="noop" aria-role="button" aria-label="点击空白处收起筛选"></view>
  <view class="filter-panel {{filterPanelOpen ? 'open' : ''}}" catchtouchmove="noop" aria-hidden="{{!filterPanelOpen}}">
    <view class="filter-group">
      <text class="filter-group-title">排序依据</text>
      <view class="filter-option-grid">
        <view wx:for="{{sortOptions}}" wx:for-item="option" wx:key="key" class="filter-option {{sortKey === option.key ? 'selected' : ''}}" data-kind="sort" data-key="{{option.key}}" bindtap="onSelectFilterOption" aria-role="button" aria-label="{{option.label}}{{sortKey === option.key ? '，已选择' : ''}}"><text class="filter-option-label">{{option.shortLabel || option.label}}</text></view>
      </view>
    </view>
    <view class="filter-group">
      <text class="filter-group-title">制作方式</text>
      <view class="filter-option-grid">
        <view wx:for="{{prepOptions}}" wx:for-item="option" wx:key="key" class="filter-option {{prepType === option.key ? 'selected' : ''}}" data-kind="preparation" data-key="{{option.key}}" bindtap="onSelectFilterOption" aria-role="button" aria-label="{{option.label}}{{prepType === option.key ? '，已选择' : ''}}"><text class="filter-option-label">{{option.shortLabel || option.label}}</text></view>
      </view>
    </view>
    <view class="filter-group">
      <text class="filter-group-title">材料条件</text>
      <view class="filter-option-grid">
        <view wx:for="{{materialOptions}}" wx:for-item="option" wx:key="key" class="filter-option {{materialCondition === option.key ? 'selected' : ''}}" data-kind="material" data-key="{{option.key}}" bindtap="onSelectFilterOption" aria-role="button" aria-label="{{option.label}}{{materialCondition === option.key ? '，已选择' : ''}}"><text class="filter-option-label">{{option.shortLabel || option.label}}</text></view>
      </view>
    </view>
    <view class="filter-group">
      <text class="filter-group-title">评价</text>
      <view class="filter-option-grid">
        <view wx:for="{{ratingOptions}}" wx:for-item="option" wx:key="key" class="filter-option {{rating === option.key ? 'selected' : ''}}" data-kind="rating" data-key="{{option.key}}" bindtap="onSelectFilterOption" aria-role="button" aria-label="{{option.label}}{{rating === option.key ? '，已选择' : ''}}"><text class="filter-option-label">{{option.label}}</text></view>
      </view>
    </view>
    <view class="filter-group">
      <text class="filter-group-title">调酒状态</text>
      <view class="filter-option-grid">
        <view wx:for="{{statusOptions}}" wx:for-item="option" wx:key="key" class="filter-option {{triedStatus === option.key ? 'selected' : ''}}" data-kind="status" data-key="{{option.key}}" bindtap="onSelectFilterOption" aria-role="button" aria-label="{{option.label}}{{triedStatus === option.key ? '，已选择' : ''}}"><text class="filter-option-label">{{option.shortLabel || option.label}}</text></view>
      </view>
    </view>
    <view class="filter-actions">
      <button class="filter-reset" bindtap="resetFilterPanel">重置</button>
      <button class="filter-collapse" bindtap="collapseFilterPanel">收起</button>
    </view>
  </view>

  <view wx:if="{{loadingRecipes}}" class="loading-state" aria-label="酒单加载中">
    <view class="loading-spinner" aria-hidden="true"></view>
    <text>酒单加载中…</text>
  </view>
  <view wx:elif="{{recipes.length}}" class="card-list">
    <recipe-card wx:for="{{recipes}}" wx:key="id" recipe="{{item}}" bind:select="onSelectRecipe" />
  </view>
  <view wx:elif="{{hasRecipes}}" class="empty no-results">
    <text class="empty-title">没有符合条件的酒</text>
    <text class="empty-copy">换个制作方式、材料条件或评价再看看。</text>
    <button class="empty-button secondary" bindtap="clearFilters">清除筛选</button>
  </view>
  <view wx:else class="empty">
    <text class="empty-title">还没有收藏的酒</text>
    <text class="empty-copy">从第一款常喝的酒开始，慢慢搭建自己的酒单。</text>
    <button class="empty-button" bindtap="onAddRecipe">录入我的第一款酒</button>
  </view>
  </block>

  <block wx:else>
    <view class="friend-section-heading">
      <view><text class="friend-section-title">收到的酒单</text><text class="friend-section-copy">好友更新后，这里会展示最新内容</text></view>
      <text class="preview-badge">界面预览</text>
    </view>
    <view wx:if="{{friendMenusState === 'loading'}}" class="loading-state friend-loading" aria-label="好友酒单加载中">
      <view class="loading-spinner" aria-hidden="true"></view><text>好友酒单加载中…</text>
    </view>
    <view wx:elif="{{friendMenusState === 'error'}}" class="empty friend-empty">
      <text class="empty-title">暂时没能读取好友酒单</text>
      <text class="empty-copy">{{friendMenusError}}</text>
      <button class="empty-button secondary" bindtap="onRetryFriendMenus">重新加载</button>
    </view>
    <view wx:elif="{{friendMenusState === 'empty'}}" class="empty friend-empty">
      <text class="empty-title">还没有收到好友酒单</text>
      <text class="empty-copy">好友通过微信分享的实时酒单会保存在这里。</text>
    </view>
    <view wx:else class="friend-menu-list">
      <view wx:for="{{friendMenus}}" wx:key="id" class="friend-menu-card" data-id="{{item.id}}" bindtap="onSelectFriendMenu" aria-role="button" aria-label="打开{{item.ownerName}}分享的{{item.name}}">
        <view class="friend-menu-main">
          <view class="friend-menu-title-row"><text class="friend-menu-name">{{item.name}}</text><text class="readonly-badge">只读</text></view>
          <text class="friend-menu-meta">来自{{item.ownerName}} · {{item.recipeCount}}款酒</text>
          <view class="friend-sync-row"><view class="sync-dot"></view><text>实时同步 · 效果预览</text><text class="friend-updated">更新于{{item.updatedLabel}}</text></view>
        </view>
        <text class="friend-menu-arrow">›</text>
      </view>
    </view>
  </block>
</view>
