.recipes-page { box-sizing: border-box; min-height: 100vh; padding: 48rpx 32rpx 72rpx; background: #f8f2e9; }
.topbar { display: flex; align-items: center; box-sizing: border-box; width: 100%; }
.page-title { flex: 1; min-width: 0; color: #2f2925; font-size: 50rpx; font-weight: 750; letter-spacing: -1rpx; }
.add-hit { display: flex; align-items: center; justify-content: flex-end; flex: none; width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0; background: transparent; border-radius: 50%; }
.add-button { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; color: #fffaf4; background: linear-gradient(145deg, #bd7b31, #9d5f22); border-radius: 50%; font-size: 48rpx; font-weight: 300; line-height: 1; box-shadow: 0 10rpx 24rpx rgba(151, 91, 31, .2); }
.add-hit::after, .filter-hit::after, .sort-hit::after, .empty-button::after, .sheet-option::after { border: 0; }
.search-box { display: flex; align-items: center; height: 88rpx; margin-top: 32rpx; padding: 0 24rpx; background: rgba(255, 253, 249, .9); border: 1rpx solid #e1d5c7; border-radius: 20rpx; box-shadow: 0 6rpx 18rpx rgba(75, 56, 40, .04); }
.search-input { flex: 1; height: 88rpx; min-height: 88rpx; color: #39312b; font-size: 27rpx; }
.search-icon { flex: none; margin-right: 14rpx; color: #9b9188; font-size: 38rpx; line-height: 1; transform: rotate(-18deg); }
.filter-heading { display: flex; align-items: center; box-sizing: border-box; width: 100%; margin-top: 22rpx; }
.filter-heading-title { flex: none; color: #4a4038; font-size: 26rpx; font-weight: 650; }
.sort-hit { display: block; box-sizing: border-box; flex: 1; min-width: 0; min-height: 88rpx; margin: 0; padding: 0; color: #82746a; background: transparent; font-size: 21rpx; line-height: 88rpx; text-align: right; }
.sort-hit--pressed { opacity: .65; }
.sort-icon { margin-left: 8rpx; color: #5b4d43; font-size: 27rpx; }
.filter-grid { display: flex; box-sizing: border-box; width: 100%; gap: 8rpx; }
.filter-hit { display: flex; align-items: flex-start; justify-content: center; box-sizing: border-box; flex: 1 1 0; width: 0; min-width: 0; min-height: 88rpx; margin: 0; padding: 10rpx 8rpx 10rpx 12rpx; flex-direction: column; color: #5f544b; background: #fffaf5; border: 1rpx solid #e2d4c4; border-radius: 18rpx; line-height: 1; text-align: left; box-shadow: 0 5rpx 16rpx rgba(79, 57, 39, .035); }
.filter-hit.active { border-color: #b8793b; background: #f4e6d6; box-shadow: inset 0 0 0 1rpx rgba(171, 105, 42, .12); }
.filter-name { display: block; color: #9a8b7e; font-size: 19rpx; }
.filter-value { display: flex; align-items: center; width: 100%; min-width: 0; margin-top: 8rpx; color: #433a33; font-size: 23rpx; font-weight: 650; white-space: nowrap; }
.filter-value-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.filter-value-text.long { font-size: 19rpx; letter-spacing: -1rpx; }
.chevron { flex: none; margin-left: 4rpx; color: #9b6a3c; font-size: 22rpx; }
.untried-filter-row { display: flex; align-items: center; justify-content: flex-end; width: 100%; margin-top: 4rpx; }
.untried-toggle.untried-toggle { display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; min-height: 88rpx; margin: 0; padding: 0 2rpx 0 10rpx; color: #655b53; background: transparent; border-radius: 999rpx; font-size: 22rpx; line-height: 1; }
.untried-toggle::after { border: 0; }
.untried-toggle.active { color: #405846; font-weight: 600; }
.toggle-track { position: relative; flex: none; width: 54rpx; height: 30rpx; background: #d8d2cc; border-radius: 999rpx; transition: background .18s ease; }
.toggle-thumb { position: absolute; top: 3rpx; left: 3rpx; width: 24rpx; height: 24rpx; background: #fffdf9; border-radius: 50%; box-shadow: 0 2rpx 6rpx rgba(64, 54, 47, .18); transition: transform .18s ease; }
.untried-toggle.active .toggle-track { background: #78917d; }
.untried-toggle.active .toggle-thumb { transform: translateX(24rpx); }
.card-list { display: grid; box-sizing: border-box; width: 100%; gap: 18rpx; margin-top: 4rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 210rpx 28rpx 0; text-align: center; }
.empty-title { color: #2f2925; font-size: 34rpx; font-weight: 650; }
.empty-copy { max-width: 590rpx; margin-top: 18rpx; color: #8b7d72; font-size: 26rpx; line-height: 1.7; }
.empty-button { min-width: 400rpx; margin-top: 38rpx; padding: 0 40rpx; color: #fffaf4; background: #aa6828; border-radius: 999rpx; font-size: 27rpx; font-weight: 600; line-height: 88rpx; }
.empty-button.secondary { color: #76502e; background: #f0e3d4; }
.sheet-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(42, 34, 28, .36); }
.sheet { box-sizing: border-box; width: 100%; padding: 18rpx 32rpx calc(30rpx + env(safe-area-inset-bottom)); background: #fffaf2; border-radius: 34rpx 34rpx 0 0; box-shadow: 0 -12rpx 40rpx rgba(59, 43, 31, .12); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; background: #d6c9ba; border-radius: 99rpx; }
.sheet-title { display: block; margin-bottom: 12rpx; color: #302924; font-size: 34rpx; font-weight: 700; }
.sheet-option { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 84rpx; margin: 0; padding: 0 4rpx; color: #62574e; background: transparent; border-bottom: 1rpx solid #eee3d7; border-radius: 0; font-size: 28rpx; line-height: 84rpx; text-align: left; }
.sheet-option.selected { color: #9d5e21; font-weight: 650; }
.check { font-weight: 800; }
