.recipes-page { position: relative; box-sizing: border-box; min-height: 100vh; padding: 48rpx 32rpx 72rpx; background: #f8f5ee; }
.menu-source-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); box-sizing: border-box; height: 76rpx; margin-bottom: 22rpx; padding: 6rpx; background: #ebe7df; border-radius: 18rpx; }
.menu-source-tab { display: flex; align-items: center; justify-content: center; color: #77736c; border-radius: 14rpx; font-size: 26rpx; font-weight: 600; transition: background 160ms ease, color 160ms ease, box-shadow 160ms ease; }
.menu-source-tab.selected { color: #242321; background: #fffefc; box-shadow: 0 4rpx 14rpx rgba(55, 50, 43, .1); }
.friend-section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin: 8rpx 4rpx 26rpx; }
.friend-section-title { display: block; color: #242321; font-size: 36rpx; font-weight: 700; }
.friend-section-copy { display: block; margin-top: 8rpx; color: #77736c; font-size: 22rpx; }
.preview-badge { flex: none; padding: 8rpx 14rpx; color: #7c6049; background: #f4eee8; border-radius: 999rpx; font-size: 19rpx; }
.friend-menu-list { display: grid; gap: 18rpx; }
.friend-menu-card { display: flex; align-items: center; box-sizing: border-box; min-height: 184rpx; padding: 26rpx 22rpx; background: #fffefc; border: 1rpx solid #e5dfd5; border-radius: 24rpx; box-shadow: 0 10rpx 28rpx rgba(55, 50, 43, .07); }
.friend-avatar { display: flex; width: 82rpx; height: 82rpx; flex: none; align-items: center; justify-content: center; color: #ffffff; background: #5f5146; border-radius: 50%; font-size: 30rpx; font-weight: 650; }
.friend-menu-main { min-width: 0; margin-left: 20rpx; flex: 1; }
.friend-menu-title-row { display: flex; min-width: 0; align-items: center; gap: 12rpx; }
.friend-menu-name { min-width: 0; overflow: hidden; color: #242321; font-size: 30rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.readonly-badge { flex: none; padding: 5rpx 10rpx; color: #6f6c66; background: #f1f0ec; border-radius: 999rpx; font-size: 18rpx; }
.friend-menu-meta { display: block; margin-top: 10rpx; color: #6f6c66; font-size: 23rpx; }
.friend-sync-row { display: flex; min-width: 0; align-items: center; gap: 8rpx; margin-top: 12rpx; color: #4d7d67; font-size: 20rpx; }
.sync-dot { width: 12rpx; height: 12rpx; flex: none; background: #58a278; border-radius: 50%; box-shadow: 0 0 0 5rpx rgba(88, 162, 120, .12); }
.friend-updated { min-width: 0; margin-left: auto; overflow: hidden; color: #9d9991; text-overflow: ellipsis; white-space: nowrap; }
.friend-menu-arrow { flex: none; margin-left: 10rpx; color: #9d9991; font-size: 44rpx; font-weight: 300; }
.friend-loading { padding-top: 130rpx; }
.friend-empty { padding-top: 160rpx; }
.recipes-page.filter-open { height: 100vh; overflow: hidden; }
.ai-naming-banner { display: flex; align-items: center; box-sizing: border-box; min-height: 132rpx; margin-bottom: 18rpx; padding: 22rpx 24rpx; color: #ffffff; background: #3b3936; border-radius: 22rpx; box-shadow: 0 12rpx 30rpx rgba(55, 50, 43, .16); }
.ai-banner-copy { flex: 1; min-width: 0; }
.ai-banner-title-row { display: flex; align-items: center; gap: 12rpx; }
.ai-badge { flex: none; padding: 4rpx 10rpx; color: #3d2f25; background: #ead8c7; border-radius: 999rpx; font-size: 19rpx; }
.ai-banner-title { overflow: hidden; font-size: 27rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.ai-banner-hint { display: block; margin-top: 10rpx; color: rgba(255,255,255,.72); font-size: 21rpx; line-height: 1.4; }
.ai-banner-arrow { flex: none; margin-left: 14rpx; font-size: 48rpx; font-weight: 300; }
.add-hit { flex: none; width: auto; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0 20rpx; color: #ffffff; background: #242321; border-radius: 999rpx; font-size: 21rpx; line-height: 64rpx; }
.add-hit::after, .filter-trigger::after, .filter-option::after, .filter-reset::after, .filter-collapse::after, .empty-button::after { border: 0; }
.search-box { display: flex; align-items: center; height: 88rpx; margin-top: 0; padding: 0 24rpx; background: rgba(255, 254, 252, .94); border: 1rpx solid #ebe7df; border-radius: 20rpx; box-shadow: 0 8rpx 24rpx rgba(55, 50, 43, .055); }
.search-input { flex: 1; height: 88rpx; min-height: 88rpx; color: #242321; font-size: 27rpx; }
.search-icon { flex: none; margin-right: 14rpx; color: #6f6c66; font-size: 38rpx; line-height: 1; transform: rotate(-18deg); }
.seasonal-fruit-tip { display: -webkit-box; max-height: 68.2rpx; margin: 10rpx 6rpx 0; overflow: hidden; color: #6f6c66; font-size: 22rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.filter-bar { position: relative; z-index: 11; display: flex; align-items: center; box-sizing: border-box; width: 100%; margin-top: 8rpx; }
.filter-trigger { display: flex; align-items: center; justify-content: flex-start; box-sizing: border-box; flex: 1; width: auto; min-width: 0; min-height: 88rpx; margin: 0; margin-left: 0; margin-right: 0; padding: 0 4rpx; color: #242321; background: transparent; border-radius: 0; font-size: 28rpx; font-weight: 700; line-height: 88rpx; text-align: left; }
.filter-trigger-label { position: relative; display: block; }
.filter-trigger-label::after { position: absolute; right: 0; bottom: 12rpx; left: 0; height: 4rpx; background: #957052; border-radius: 99rpx; content: ''; }
.recipe-count { box-sizing: border-box; min-width: 48rpx; margin-left: 14rpx; padding: 6rpx; color: #957052; background: #f4eee8; border-radius: 999rpx; font-size: 22rpx; font-weight: 400; line-height: 1.2; text-align: center; }
.filter-symbol { display: flex; align-items: flex-start; justify-content: center; width: 28rpx; height: 28rpx; margin-left: 12rpx; flex-direction: column; gap: 4rpx; }
.filter-symbol-line { display: block; height: 3rpx; background: #6f6c66; border-radius: 99rpx; }
.filter-symbol.active .filter-symbol-line { background: #957052; }
.filter-symbol-line.line-long { width: 24rpx; }
.filter-symbol-line.line-medium { width: 17rpx; }
.filter-symbol-line.line-short { width: 10rpx; }
.filter-scroll-lock { position: fixed; z-index: 8; inset: 0; background: transparent; }
.filter-panel { position: absolute; z-index: 10; right: 32rpx; left: 32rpx; box-sizing: border-box; max-width: calc(100vw - 64rpx); margin: 0; padding: 12rpx 12rpx 0; overflow-x: hidden; overflow-y: hidden; opacity: 0; visibility: hidden; pointer-events: none; background: #fffefc; border: 1rpx solid #e7e4dd; border-radius: 20rpx; box-shadow: 0 18rpx 48rpx rgba(55, 50, 43, .14); transform: translateY(-14rpx) scale(.985); transform-origin: top center; transition: opacity 160ms ease-out, transform 220ms cubic-bezier(.2, .8, .2, 1), visibility 0s linear 220ms; }
.filter-panel.open { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0) scale(1); transition-delay: 0s; }
.filter-group { margin-top: 8rpx; }
.filter-group:first-child { margin-top: 0; }
.filter-group-title { display: block; margin-bottom: 6rpx; color: #6f6c66; font-size: 22rpx; line-height: 1.2; }
.filter-option-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8rpx; width: 100%; }
.filter-option { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; min-height: 56rpx; margin: 0; padding: 4rpx 2rpx; overflow: hidden; color: #242321; background: #f1f0ec; border-radius: 12rpx; line-height: 1.2; }
.filter-option-label { box-sizing: border-box; display: block; width: 100%; min-width: 0; max-width: 100%; overflow: hidden; font-size: 20rpx; white-space: nowrap; text-align: center; }
.filter-option.selected { color: #7c6049; background: #f4eee8; font-weight: 650; }
.filter-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 12rpx -12rpx 0; background: #ffffff; border-top: 1rpx solid #e7e4dd; }
.filter-reset, .filter-collapse { min-height: 72rpx; margin: 0; padding: 0; color: #242321; background: transparent; border-radius: 0; font-size: 23rpx; font-weight: 400; line-height: 72rpx; }
.filter-reset { border-right: 1rpx solid #e7e4dd; }
.filter-collapse { color: #242321; }
.card-list { display: grid; box-sizing: border-box; width: 100%; gap: 18rpx; margin-top: 4rpx; }
.loading-state { display: flex; align-items: center; justify-content: center; padding: 180rpx 28rpx 0; color: #6f6c66; font-size: 25rpx; gap: 16rpx; }
.loading-spinner { box-sizing: border-box; width: 30rpx; height: 30rpx; border: 3rpx solid #dedbd4; border-top-color: #6f6c66; border-radius: 50%; animation: recipe-loading-spin .8s linear infinite; }
@keyframes recipe-loading-spin { to { transform: rotate(360deg); } }
.empty { display: flex; flex-direction: column; align-items: center; padding: 210rpx 28rpx 0; text-align: center; }
.empty-title { color: #242321; font-size: 34rpx; font-weight: 650; }
.empty-copy { max-width: 590rpx; margin-top: 18rpx; color: #6f6c66; font-size: 26rpx; line-height: 1.7; }
.empty-button { min-width: 400rpx; margin-top: 38rpx; padding: 0 40rpx; color: #ffffff; background: #242321; border-radius: 999rpx; font-size: 27rpx; font-weight: 600; line-height: 88rpx; }
.empty-button.secondary { color: #957052; background: #f1f0ec; }
