.recipes-page { position: relative; box-sizing: border-box; min-height: 100vh; padding: 48rpx 32rpx 72rpx; background: #f8f2e9; }
.recipes-page.filter-open { height: 100vh; overflow: hidden; }
.add-hit { display: flex; align-items: center; justify-content: flex-end; flex: none; width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0; background: transparent; border-radius: 50%; }
.add-button { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; color: #fffaf4; background: linear-gradient(145deg, #bd7b31, #9d5f22); border-radius: 50%; font-size: 48rpx; font-weight: 300; line-height: 1; box-shadow: 0 10rpx 24rpx rgba(151, 91, 31, .2); }
.add-hit::after, .filter-trigger::after, .filter-option::after, .filter-reset::after, .filter-collapse::after, .empty-button::after { border: 0; }
.search-box { display: flex; align-items: center; height: 88rpx; margin-top: 0; padding: 0 24rpx; background: rgba(255, 253, 249, .9); border: 1rpx solid #e1d5c7; border-radius: 20rpx; box-shadow: 0 6rpx 18rpx rgba(75, 56, 40, .04); }
.search-input { flex: 1; height: 88rpx; min-height: 88rpx; color: #39312b; font-size: 27rpx; }
.search-icon { flex: none; margin-right: 14rpx; color: #9b9188; font-size: 38rpx; line-height: 1; transform: rotate(-18deg); }
.seasonal-fruit-tip { display: -webkit-box; max-height: 68.2rpx; margin: 10rpx 6rpx 0; overflow: hidden; color: #91857b; font-size: 22rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.filter-bar { position: relative; z-index: 11; display: flex; align-items: center; box-sizing: border-box; width: 100%; margin-top: 8rpx; }
.filter-trigger { display: flex; align-items: center; justify-content: flex-start; box-sizing: border-box; flex: 1; width: auto; min-width: 0; min-height: 88rpx; margin: 0; margin-left: 0; margin-right: 0; padding: 0 4rpx; color: #3f3832; background: transparent; border-radius: 0; font-size: 28rpx; font-weight: 700; line-height: 88rpx; text-align: left; }
.filter-trigger-label { position: relative; display: block; }
.filter-trigger-label::after { position: absolute; right: 0; bottom: 12rpx; left: 0; height: 4rpx; background: #b86f29; border-radius: 99rpx; content: ''; }
.filter-symbol { display: flex; align-items: flex-start; justify-content: center; width: 28rpx; height: 28rpx; margin-left: 12rpx; flex-direction: column; gap: 4rpx; }
.filter-symbol-line { display: block; height: 3rpx; background: #5f554d; border-radius: 99rpx; }
.filter-symbol.active .filter-symbol-line { background: #b86f29; }
.filter-symbol-line.line-long { width: 24rpx; }
.filter-symbol-line.line-medium { width: 17rpx; }
.filter-symbol-line.line-short { width: 10rpx; }
.filter-scroll-lock { position: fixed; z-index: 8; inset: 0; background: transparent; }
.filter-panel { position: absolute; z-index: 10; right: 32rpx; left: 32rpx; box-sizing: border-box; max-width: calc(100vw - 64rpx); margin: 0; padding: 12rpx 12rpx 0; overflow-x: hidden; overflow-y: hidden; opacity: 0; visibility: hidden; pointer-events: none; background: #fffaf2; border: 1rpx solid #e4d9cc; border-radius: 20rpx; box-shadow: 0 18rpx 48rpx rgba(73, 52, 36, .16); transform: translateY(-14rpx) scale(.985); transform-origin: top center; transition: opacity 160ms ease-out, transform 220ms cubic-bezier(.2, .8, .2, 1), visibility 0s linear 220ms; }
.filter-panel.open { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0) scale(1); transition-delay: 0s; }
.filter-group { margin-top: 8rpx; }
.filter-group:first-child { margin-top: 0; }
.filter-group-title { display: block; margin-bottom: 6rpx; color: #80756d; font-size: 22rpx; line-height: 1.2; }
.filter-option-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8rpx; width: 100%; }
.filter-option { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; min-height: 56rpx; margin: 0; padding: 4rpx 2rpx; overflow: hidden; color: #554c45; background: #eeeae5; border-radius: 12rpx; line-height: 1.2; }
.filter-option-label { box-sizing: border-box; display: block; width: 100%; min-width: 0; max-width: 100%; overflow: hidden; font-size: 20rpx; white-space: nowrap; text-align: center; }
.filter-option.selected { color: #9b5c22; background: #f3e4d3; font-weight: 650; }
.filter-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 12rpx -12rpx 0; background: #fffaf2; border-top: 1rpx solid #e3d9ce; }
.filter-reset, .filter-collapse { min-height: 72rpx; margin: 0; padding: 0; color: #4f4741; background: transparent; border-radius: 0; font-size: 23rpx; font-weight: 600; line-height: 72rpx; }
.filter-reset { border-right: 1rpx solid #e3d9ce; }
.filter-collapse { color: #8f5728; }
.card-list { display: grid; box-sizing: border-box; width: 100%; gap: 18rpx; margin-top: 4rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 210rpx 28rpx 0; text-align: center; }
.empty-title { color: #2f2925; font-size: 34rpx; font-weight: 650; }
.empty-copy { max-width: 590rpx; margin-top: 18rpx; color: #8b7d72; font-size: 26rpx; line-height: 1.7; }
.empty-button { min-width: 400rpx; margin-top: 38rpx; padding: 0 40rpx; color: #fffaf4; background: #aa6828; border-radius: 999rpx; font-size: 27rpx; font-weight: 600; line-height: 88rpx; }
.empty-button.secondary { color: #76502e; background: #f0e3d4; }
