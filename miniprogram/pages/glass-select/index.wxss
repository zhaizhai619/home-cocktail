.glass-select-page { height: 100vh; background: #f8f5ee; }
.page-content { box-sizing: border-box; min-height: 100%; padding: 28rpx 28rpx 0; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.page-head { display: flex; align-items: center; justify-content: flex-end; }
.page-add { width: auto; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0 20rpx; color: #ffffff; background: #242321; border-radius: 999rpx; font-size: 23rpx; line-height: 64rpx; }
.page-add::after, .sheet-close::after, .save-glass::after { border: 0; }
.orphan-warning { margin-top: 18rpx; padding: 18rpx; color: #985a54; background: #f5ebe9; border-radius: 16rpx; font-size: 23rpx; line-height: 1.5; }
.glass-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: 14rpx 12rpx; margin-top: 22rpx; }
.glass-card { display: flex; box-sizing: border-box; min-width: 0; min-height: 176rpx; padding: 20rpx 16rpx; align-items: center; justify-content: center; background: #ffffff; border: 2rpx solid #e7e4dd; border-radius: 22rpx; box-shadow: 0 7rpx 18rpx rgba(0, 0, 0, .045); }
.glass-card.selected { background: #f1f0ec; border-color: #242321; box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, .12); }
.clear-card { color: #6f6c66; }
.glass-label { display: block; max-width: 100%; overflow: hidden; color: #242321; font-size: 27rpx; font-weight: 650; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.empty-hint { margin-top: 24rpx; padding: 28rpx 20rpx; color: #6f6c66; background: rgba(255, 255, 255, .7); border: 1rpx dashed #e7e4dd; border-radius: 20rpx; font-size: 23rpx; text-align: center; }
.sheet-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(0, 0, 0, .38); }
.sheet { box-sizing: border-box; width: 100%; padding: 18rpx 32rpx calc(54rpx + env(safe-area-inset-bottom)); background: #ffffff; border-radius: 36rpx 36rpx 0 0; }
.sheet-title { display: block; margin-bottom: 26rpx; font-size: 34rpx; font-weight: 700; }
.sheet-heading { display: flex; align-items: center; justify-content: space-between; }
.sheet-heading .sheet-title { margin-bottom: 0; }
.sheet-close { display: flex; width: 64rpx; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0; align-items: center; justify-content: center; color: #6f6c66; background: #f1f0ec; border-radius: 50%; font-size: 34rpx; line-height: 64rpx; }
.glass-editor { padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }
.glass-editor .field-label:first-of-type { margin-top: 26rpx; }
.field-label { display: block; margin: 22rpx 0 10rpx; color: #6f6c66; font-size: 24rpx; }
.glass-input { box-sizing: border-box; width: 100%; height: 80rpx; padding: 0 20rpx; background: #ffffff; border: 1rpx solid #e7e4dd; border-radius: 18rpx; font-size: 27rpx; }
.form-error { display: block; margin-top: 12rpx; color: #985a54; font-size: 22rpx; }
.save-glass { box-sizing: border-box; width: 240rpx; height: 64rpx; min-height: 64rpx; margin: 20rpx auto 0; padding: 0 24rpx; color: #ffffff; background: #242321; border-radius: 18rpx; font-size: 25rpx; font-weight: 400; line-height: 64rpx; }
