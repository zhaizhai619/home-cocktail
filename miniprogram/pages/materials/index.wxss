.materials-page { display: flex; box-sizing: border-box; height: 100vh; overflow: hidden; flex-direction: column; }
.section-head, .amount-row { display: flex; align-items: center; }
.section-head { justify-content: space-between; }
.bar-switch { display: grid; flex: none; grid-template-columns: repeat(2, minmax(0, 1fr)); border-bottom: 1rpx solid #e7e4dd; }
.materials-page .bar-switch-item { position: relative; width: 100%; height: 78rpx; min-height: 78rpx; margin: 0; padding: 0; color: #9d9991; background: transparent; border-radius: 0; font-size: 27rpx; line-height: 78rpx; }
.materials-page .bar-switch-item.selected { color: #242321; font-weight: 650; }
.materials-page .bar-switch-item.selected::before { position: absolute; right: 0; bottom: -1rpx; left: 0; height: 4rpx; background: #7f7b74; content: ''; }
.bar-switch-item::after { border: 0; }
.bar-swiper { height: 0; min-height: 0; flex: 1; }
.bar-scroll { height: 100%; }
.pane-content { box-sizing: border-box; min-height: 100%; padding: 0 28rpx 180rpx; }
.glass-pane { padding-top: 30rpx; }
.pane-toolbar { display: flex; align-items: center; gap: 12rpx; padding-top: 24rpx; }
.search-box { display: flex; height: 76rpx; margin: 0; padding: 0 20rpx; flex: 1; align-items: center; background: #fffefc; border: 1rpx solid #ebe7df; border-radius: 20rpx; box-shadow: 0 6rpx 18rpx rgba(55, 50, 43, .045); }
.search-box input { flex: 1; font-size: 28rpx; }
.search-icon { margin-right: 14rpx; color: #6f6c66; font-size: 34rpx; }
.materials-page .pane-add { flex: none; width: auto; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0 20rpx; color: #ffffff; background: #242321; border-radius: 999rpx; font-size: 23rpx; line-height: 64rpx; }
.pane-add::after { border: 0; }
.section { margin-top: 34rpx; }
.section-title { display: block; font-size: 34rpx; font-weight: 700; }
.section-note { display: block; margin-top: 6rpx; color: #6f6c66; font-size: 23rpx; }
.count { min-width: 48rpx; padding: 6rpx; color: #957052; background: #f4eee8; border-radius: 999rpx; text-align: center; }

.fresh-section-head { min-height: 74rpx; }
.fresh-section-state { display: flex; align-items: center; gap: 14rpx; }
.fresh-disclosure-chevron { box-sizing: border-box; width: 16rpx; height: 16rpx; margin: -7rpx 8rpx 0 2rpx; border-right: 4rpx solid #6f6c66; border-bottom: 4rpx solid #6f6c66; border-radius: 1rpx; transform: rotate(45deg); transition: transform 180ms ease; }
.fresh-disclosure-chevron.is-expanded { margin-top: 7rpx; transform: rotate(-135deg); }
.fresh-list { display: grid; gap: 10rpx; margin-top: 16rpx; }
.fresh-card { box-sizing: border-box; width: 100%; overflow: hidden; background: #fffefc; border: 1rpx solid #ebe7df; border-radius: 20rpx; box-shadow: 0 8rpx 22rpx rgba(55, 50, 43, .055); }
.fresh-summary { display: grid; min-height: 82rpx; padding: 12rpx 16rpx; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 12rpx; }
.fresh-name { display: block; overflow: hidden; color: #242321; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.fresh-remaining { display: inline-flex; min-width: 0; align-items: center; justify-content: center; justify-self: center; color: #6f6c66; font-size: 23rpx; line-height: 1.35; white-space: nowrap; }
.fresh-remaining.is-alert { box-sizing: border-box; min-height: 48rpx; padding: 0 12rpx; color: #985a54; background: #f6e3df; border: 1rpx solid #d98c82; border-radius: 12rpx; }
.fresh-remaining-label.is-empty { text-decoration: underline; text-underline-offset: 6rpx; }
.fresh-alert-mark { margin-right: 8rpx; color: #b7655f; font-size: 25rpx; font-weight: 800; }
.materials-page .use-up { width: 72rpx; min-height: 48rpx; margin: 0; padding: 0; justify-self: end; color: #6f6c66; background: transparent; border: 1rpx solid #d8d4cc; border-radius: 999rpx; font-size: 22rpx; line-height: 46rpx; }
.fresh-detail-meta { display: grid; padding: 14rpx 20rpx; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 16rpx; color: #6f6c66; border-bottom: 1rpx solid #e7e4dd; font-size: 23rpx; line-height: 1.4; }
.fresh-detail-meta text:last-child { text-align: right; }
.fresh-recipes { padding: 8rpx 14rpx 12rpx; background: #ffffff; }
.materials-page .fresh-recipe-row { display: grid; box-sizing: border-box; width: 100%; min-height: 74rpx; margin: 0; padding: 10rpx 4rpx; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12rpx; color: #242321; background: transparent; border-bottom: 1rpx solid #f1f0ec; border-radius: 0; line-height: 1.3; text-align: left; }
.fresh-recipe-rating { min-width: 64rpx; padding: 5rpx 9rpx; color: #6f6c66; background: #f1f0ec; border-radius: 999rpx; font-size: 19rpx; text-align: center; }
.fresh-recipe-name { overflow: hidden; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.fresh-recipe-amount { max-width: 180rpx; overflow: hidden; color: #6f6c66; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.fresh-recipes-empty { padding: 22rpx 8rpx; color: #9d9991; font-size: 22rpx; text-align: center; }
.empty-fresh, .empty-list { display: flex; flex-direction: column; align-items: center; margin-top: 20rpx; padding: 40rpx 24rpx; color: #6f6c66; background: rgba(255, 255, 255, .7); border: 1rpx dashed #e7e4dd; border-radius: 24rpx; }
.empty-sub { margin-top: 8rpx; color: #9d9991; font-size: 23rpx; }

.catalog-tabs { width: 100%; margin-top: 20rpx; white-space: nowrap; }
.catalog-tab-track { display: inline-flex; align-items: center; gap: 10rpx; padding-right: 20rpx; }
.materials-page .catalog-tab { flex: none; width: auto; height: 60rpx; min-height: 60rpx; margin: 0; padding: 0 20rpx; color: #6f6c66; background: #f1f0ec; border: 1rpx solid #e7e4dd; border-radius: 999rpx; font-size: 23rpx; line-height: 58rpx; }
.materials-page .catalog-tab.selected { color: #242321; background: #e8e5df; border-color: #d8d4cc; }
.catalog-tab::after, .library-card::after { border: 0; }
.library-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: 14rpx 12rpx; margin-top: 18rpx; }
.materials-page .library-card { display: flex; box-sizing: border-box; width: 100%; min-width: 0; min-height: 176rpx; margin: 0; padding: 18rpx 14rpx; flex-direction: column; align-items: center; justify-content: center; color: #242321; background: #fffefc; border: 1rpx solid #e7e4dd; border-radius: 22rpx; box-shadow: 0 8rpx 24rpx rgba(55, 50, 43, .07); line-height: 1.25; }
.library-card.state-owned { background: #fffefc; border: 1rpx solid #e7e4dd; box-shadow: 0 8rpx 24rpx rgba(55, 50, 43, .07); }
.library-card.state-missing-long-term, .library-card.state-quick-buy { background: #f1f0ec; border: 1rpx solid #e7e4dd; box-shadow: none; }
.library-card-name { display: block; max-width: 100%; overflow: hidden; color: #242321; font-size: 28rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.library-card-category { display: block; margin-top: 22rpx; color: #9d9991; font-size: 22rpx; }
.state-owned .library-card-category { color: #6f6c66; }
.library-card.state-missing-long-term .library-card-name, .library-card.state-quick-buy .library-card-name { color: #8b877f; }
.library-card.state-missing-long-term .library-card-category, .library-card.state-quick-buy .library-card-category { color: #aaa69e; }
.empty-materials { margin-top: 32rpx; color: #9d9991; font-size: 23rpx; line-height: 1.5; text-align: center; }
.glass-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: 14rpx 12rpx; margin-top: 22rpx; }
.glass-card { position: relative; display: flex; box-sizing: border-box; min-width: 0; min-height: 176rpx; padding: 20rpx 46rpx 20rpx 16rpx; align-items: center; justify-content: center; background: #fffefc; border: 1rpx solid #e7e4dd; border-radius: 22rpx; box-shadow: 0 8rpx 24rpx rgba(55, 50, 43, .07); }
.glass-card-label { display: block; max-width: 100%; overflow: hidden; color: #242321; font-size: 27rpx; font-weight: 650; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.materials-page .glass-delete { position: absolute; top: 8rpx; right: 8rpx; display: flex; width: 44rpx; height: 44rpx; min-height: 44rpx; margin: 0; padding: 0; align-items: center; justify-content: center; color: #985a54; background: #f5ebe9; border-radius: 50%; font-size: 28rpx; line-height: 44rpx; }
.glass-delete::after { border: 0; }
.empty-list button { margin-top: 20rpx; color: #ffffff; background: #242321; font-size: 24rpx; }

.sheet-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(0, 0, 0, .38); }
.sheet { box-sizing: border-box; width: 100%; padding: 18rpx 32rpx 54rpx; background: #ffffff; border-radius: 36rpx 36rpx 0 0; }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 26rpx; background: #e7e4dd; border-radius: 8rpx; }
.sheet-title { display: block; margin-bottom: 26rpx; font-size: 34rpx; font-weight: 700; }
.remaining-editor-mask { box-sizing: border-box; align-items: center; justify-content: center; padding: 32rpx; }
.remaining-editor { width: 560rpx; max-width: 100%; padding: 28rpx; border-radius: 26rpx; box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, .16); }
.remaining-editor .sheet-title { margin-bottom: 20rpx; font-size: 30rpx; font-weight: 650; }
.remaining-editor .amount-row { height: 68rpx; align-items: center; }
.materials-page .remaining-editor .amount-row input { box-sizing: border-box; height: 68rpx; min-height: 68rpx; max-height: 68rpx; padding: 0 18rpx; border-radius: 15rpx; font-size: 24rpx; line-height: 68rpx; align-self: center; }
.remaining-editor .amount-row picker { height: 68rpx; align-self: center; }
.remaining-editor .picker-value { box-sizing: border-box; height: 68rpx; min-height: 68rpx; max-height: 68rpx; min-width: 126rpx; padding: 0 18rpx; border-radius: 15rpx; font-size: 24rpx; line-height: 68rpx; }
.remaining-note { display: block; margin-top: 12rpx; color: #9d9991; font-size: 20rpx; line-height: 1.4; }
.remaining-actions { display: flex; margin-top: 22rpx; align-items: center; justify-content: center; gap: 12rpx; }
.materials-page .remaining-actions button { box-sizing: border-box; width: 136rpx; min-height: 56rpx; margin: 0; padding: 0; border-radius: 14rpx; font-size: 22rpx; font-weight: 400; line-height: 56rpx; }
.materials-page .remaining-cancel { color: #242321; background: #f1f0ec; }
.materials-page .remaining-save { color: #ffffff; background: #242321; }
.sheet-heading { display: flex; align-items: center; justify-content: space-between; }
.sheet-heading .sheet-title { margin-bottom: 0; }
.materials-page .sheet-close { display: flex; width: 64rpx; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0; align-items: center; justify-content: center; color: #6f6c66; background: #f1f0ec; border-radius: 50%; font-size: 34rpx; line-height: 64rpx; }
.glass-editor .field-label:first-of-type { margin-top: 26rpx; }
.glass-input { box-sizing: border-box; width: 100%; height: 80rpx; padding: 0 20rpx; background: #ffffff; border: 1rpx solid #e7e4dd; border-radius: 18rpx; font-size: 27rpx; }
.form-error { display: block; margin-top: 12rpx; color: #985a54; font-size: 22rpx; }
.field-label { display: block; margin: 22rpx 0 10rpx; color: #6f6c66; font-size: 24rpx; }
.tracking-note { display: block; padding: 24rpx; color: #6f6c66; background: #f1f0ec; border-radius: 18rpx; font-size: 24rpx; line-height: 1.6; }
.amount-row { gap: 16rpx; }
.amount-row input, .picker-value, .date-value { box-sizing: border-box; height: 80rpx; padding: 22rpx; background: #ffffff; border: 1rpx solid #e7e4dd; border-radius: 18rpx; font-size: 26rpx; }
.amount-row input { flex: 1; }
.picker-value { min-width: 150rpx; }
.date-value { width: 100%; }
.primary { margin-top: 34rpx; color: #ffffff; background: #242321; border-radius: 22rpx; font-size: 28rpx; }
.undo-bar { position: fixed; z-index: 20; right: 28rpx; bottom: 120rpx; left: 28rpx; display: flex; align-items: center; justify-content: space-between; padding: 16rpx 18rpx 16rpx 26rpx; color: #ffffff; background: #242321; border-radius: 22rpx; box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, .2); font-size: 25rpx; }
.undo-bar button { margin: 0; color: #ffffff; background: transparent; font-size: 25rpx; font-weight: 700; line-height: 54rpx; }
.sheet button::after, .fresh-card button::after, .undo-bar button::after { border: 0; }
