<view class="trash-page">
  <view class="intro">删除的酒单、材料、酒杯和用具会在这里保留 3 天。</view>
  <view wx:if="{{loading}}" class="empty">正在读取云端数据…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <view wx:elif="{{!items.length}}" class="empty">最近没有删除的内容</view>
  <view wx:else class="trash-list">
    <view wx:for="{{items}}" wx:key="id" class="trash-card">
      <view class="trash-copy">
        <text class="trash-name">{{item.name}}</text>
        <text class="trash-meta">{{item.typeLabel}} · 删除于 {{item.deletedAtLabel}}</text>
        <text class="trash-expiry">保留至 {{item.expiresAtLabel}}</text>
      </view>
      <button class="restore-button" data-id="{{item.id}}" bindtap="onRestore" loading="{{restoringId === item.id}}" disabled="{{!!restoringId}}">恢复</button>
    </view>
  </view>
</view>
