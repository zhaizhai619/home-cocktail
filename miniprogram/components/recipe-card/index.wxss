.recipe-card { display: flex; box-sizing: border-box; width: 100%; overflow: hidden; background: #fffdf8; border: 1rpx solid #e7ded2; border-radius: 24rpx; box-shadow: 0 8rpx 20rpx rgba(52, 47, 43, .05); }
.recipe-image { flex: 0 0 176rpx; width: 176rpx; height: 176rpx; background: #eee7dd; }
.recipe-body { flex: 1; min-width: 0; padding: 22rpx 24rpx; }
.recipe-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.recipe-name { overflow: hidden; color: #342f2b; font-size: 32rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.rating { flex: none; color: #786d63; font-size: 22rpx; }
.untried-label { flex: none; padding: 4rpx 10rpx; color: #655f59; background: #efede9; border-radius: 999rpx; font-size: 20rpx; line-height: 1.3; }
.recipe-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.prep-label { display: inline-block; padding: 4rpx 12rpx; color: #716052; background: #f0e6d8; border-radius: 999rpx; font-size: 21rpx; white-space: nowrap; }
.abv-label { display: inline-block; padding: 4rpx 12rpx; color: #285f40; background: #dceadf; border: 1rpx solid #b9d4c0; border-radius: 999rpx; font-size: 21rpx; font-weight: 650; white-space: nowrap; }
.ingredient-list { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.ingredient { padding: 4rpx 10rpx; color: #61584f; background: #f5f0e8; border-radius: 10rpx; font-size: 22rpx; }
.ingredient-amount { color: #8b8177; }
.ingredient.quick-buy { color: #81531a; background: #f8e5bd; }
.ingredient.missing-long-term { color: #766f69; background: #e6e4e0; }
.quick-buy-icon { margin-left: 6rpx; font-size: 19rpx; }

.recipe-card { min-height: 176rpx; }
.recipe-name { min-width: 0; overflow: visible; text-overflow: clip; white-space: normal; overflow-wrap: anywhere; line-height: 1.35; }
.ingredient { max-width: 100%; border: 2rpx solid transparent; overflow-wrap: anywhere; }
.ingredient.quick-buy { border-color: #b77727; color: #704411; }
.ingredient.missing-long-term { color: #625d58; }
.ingredient.prepared { color: #5b4028; background: #f8ead4; border-color: #e2bd8a; }
.ingredient.prepared .ingredient-amount { color: #8a633c; }
