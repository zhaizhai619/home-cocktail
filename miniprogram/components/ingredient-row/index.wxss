.ingredient-row { padding: 6rpx 0; border-bottom: 1rpx solid #f1f0ec; }
.ingredient-row.prepared { margin: 4rpx 0; padding: 5rpx 4rpx; background: #f1f0ec; border: 1rpx solid #e7e4dd; border-radius: 10rpx; }
.ingredient-row.prepared .name { color: #957052; background: #ffffff; border-color: #e7e4dd; }
.row-track { display: flex; align-items: center; box-sizing: border-box; width: 100%; gap: 6rpx; }
.ingredient-row.is-dragging { position: relative; z-index: 2; background: #ffffff; box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, .12); }
.drag-handle { flex: none; width: 32rpx; color: #9d9991; font-size: 28rpx; line-height: 60rpx; text-align: center; touch-action: none; }
.name, .amount, .unit, .remove { box-sizing: border-box; min-height: 60rpx; border-radius: 9rpx; font-size: 22rpx; }
.name { flex: 1; min-width: 0; padding: 0 8rpx; color: #242321; background: #ffffff; border: 1rpx solid #e7e4dd; text-align: left; }
.name.name { width: auto; min-height: 60rpx; padding: 0 8rpx; }
.readonly-name { display: block; margin: 0; overflow: hidden; line-height: 60rpx; text-overflow: ellipsis; white-space: nowrap; }
.amount { flex: none; width: 88rpx; padding: 0 6rpx; background: #ffffff; border: 1rpx solid #e7e4dd; }
.unit-picker { display: flex; flex: none; align-items: center; height: 60rpx; min-height: 60rpx; }
.unit { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 60rpx; min-height: 60rpx; padding: 0 4rpx; color: #6f6c66; background: #f1f0ec; }
.remove.remove { flex: none; width: 44rpx; height: 60rpx; min-height: 60rpx; margin: 0; padding: 0; color: #985a54; background: #f5ebe9; font-size: 26rpx; line-height: 58rpx; }
.name::after, .remove::after { border: 0; }
