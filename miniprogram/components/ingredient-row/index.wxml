<view class="ingredient-row">
  <block wx:if="{{item.isExisting}}"><text class="name readonly">{{item.nameLabel}}</text><button class="pick" bindtap="onNameTap">更换</button></block>
  <block wx:else><input class="name" data-field="name" value="{{item.name}}" placeholder="材料名称" bindinput="onInput" /><button class="pick" bindtap="onNameTap">选择</button></block>
  <picker wx:if="{{item.canEditMetadata}}" range="{{categories}}" range-key="label" value="{{item.categoryIndex}}" bindchange="onCategory"><view class="category">{{item.categoryLabel}}</view></picker>
  <text wx:else class="category">{{item.categoryLabel}}</text>
  <input class="amount" data-field="amount" value="{{item.amount}}" type="digit" placeholder="用量" bindinput="onInput" />
  <picker range="{{units}}" range-key="label" value="{{item.unitIndex}}" bindchange="onUnit"><view class="unit">{{item.unitLabel}}</view></picker>
  <button class="remove" bindtap="onRemove">删除</button>
  <label wx:if="{{item.canEditMetadata}}" class="alcoholic"><switch checked="{{item.alcoholic}}" bindchange="onAlcoholic" />含酒精</label>
  <text wx:else class="alcoholic">{{item.alcoholicLabel}}</text>
  <input wx:if="{{item.showAbvInput}}" class="abv" data-field="abv" value="{{item.abv}}" type="digit" placeholder="酒精度%（可空）" bindinput="onInput" />
  <text wx:if="{{item.showAbvReadonly}}" class="abv readonly">酒精度 {{item.abv}}%</text>
  <input class="observation" data-field="observation" value="{{item.observation}}" placeholder="本杯材料备注（可选）" bindinput="onInput" />
</view>
