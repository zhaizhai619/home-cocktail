.chips { display:flex; flex-wrap:wrap; gap:12rpx; }.chip { min-height:88rpx; margin:0; padding:8rpx 18rpx; color:#594d43; background:#f4ece1; border:2rpx solid #c7b8a8;border-radius:999rpx; font-size:24rpx; }.prep-row { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; padding:16rpx 0; border-bottom:1rpx solid #eee4d8; }.prep-row input { min-height:88rpx; padding:0 12rpx; border:1rpx solid #ded2c3; border-radius:10rpx; font-size:24rpx; }.prep-row picker { min-height:88rpx;padding:12rpx; background:#f4ece1; border-radius:10rpx; }.prep-row text { font-size:25rpx;overflow-wrap:anywhere; }
