.chips { display:flex; flex-wrap:wrap; gap:12rpx; }.chip { margin:0; padding:8rpx 18rpx; color:#685a4e; background:#f4ece1; border-radius:999rpx; font-size:24rpx; }.prep-row { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; padding:16rpx 0; border-bottom:1rpx solid #eee4d8; }.prep-row input { min-height:56rpx; padding:0 12rpx; border:1rpx solid #ded2c3; border-radius:10rpx; font-size:24rpx; }.prep-row picker { padding:12rpx; background:#f4ece1; border-radius:10rpx; }.prep-row text { font-size:25rpx; }
