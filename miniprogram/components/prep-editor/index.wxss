.chips { display: flex; flex-wrap: wrap; column-gap: 10rpx; row-gap: 8rpx; margin-top: 10rpx; }
.chip.chip { display: inline-flex; box-sizing: border-box; flex: 0 0 calc((100% - 20rpx) / 3); align-items: center; justify-content: center; width: auto; min-height: 56rpx; margin: 0; padding: 0 12rpx; color: #6f6c66; background: #f1f0ec; border: 1rpx solid transparent; border-radius: 999rpx; font-size: 22rpx; line-height: 56rpx; }
.chip.selected { color: #242321; background: #ffffff; border-color: #e7e4dd; box-shadow: 0 7rpx 16rpx rgba(0, 0, 0, .16); }
.chip::after { border: 0; }
.prep-row { display: flex; align-items: center; box-sizing: border-box; width: 100%; min-height: 68rpx; gap: 6rpx; border-bottom: 1rpx solid #f1f0ec; }
.prep-name { flex: 1; min-width: 0; color: #242321; font-size: 22rpx; font-weight: 600; }
.prep-duration-control { display: flex; flex: none; align-items: stretch; justify-content: flex-end; box-sizing: border-box; width: 300rpx; max-width: 64%; margin-left: auto; gap: 6rpx; }
.prep-duration-text { box-sizing: border-box; flex: none; width: 50%; min-height: 58rpx; padding: 0 10rpx; color: #242321; background: #ffffff; border: 1rpx solid #e7e4dd; border-radius: 9rpx; font-size: 21rpx; }
.prep-duration-unit { display: flex; flex: none; align-items: center; justify-content: center; box-sizing: border-box; width: 88rpx; min-height: 58rpx; color: #242321; background: #f1f0ec; border-radius: 9rpx; font-size: 21rpx; }
.prep-duration-unit text { line-height: 58rpx; }
